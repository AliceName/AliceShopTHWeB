@model AliceShop.Models.Category

@{
    ViewData["Title"] = "Chỉnh sửa danh mục | AliceStore";
    var oldSizes = ViewBag.CategorySizes as List<string> ?? new List<string>();
}

<main class="pt-12 pb-20 max-w-[1440px] mx-auto px-6 md:px-20 animate-fadeIn font-sans">

    <header class="mb-12">
        <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-1 font-sans">Chế độ quản trị viên</span>
        <h1 class="font-sans text-2xl md:text-3xl text-on-surface mb-2 font-bold uppercase tracking-wide">Chỉnh sửa danh mục</h1>
        <p class="text-on-surface-variant/80 font-sans text-sm font-medium">Cập nhật thông tin định danh và làm mới bộ khung kích cỡ (Size) áp dụng cho danh mục mã số #@Model.Id.</p>
    </header>

    <div class="max-w-2xl bg-white p-8 md:p-10 rounded-xl border border-outline-variant/30 shadow-[0_4px_20px_rgba(0,0,0,0.01)]">
        <form asp-action="Edit" method="post" class="space-y-8">

            <div asp-validation-summary="ModelOnly" class="text-xs font-semibold text-error bg-error-container/20 border border-error/20 p-4 rounded-md animate-fadeIn font-sans hidden" id="categoryEditValidationSummary" role="alert"></div>
            <input type="hidden" asp-for="Id" />

            <div class="space-y-2 group">
                <label asp-for="Name" class="block text-[10px] uppercase tracking-[0.15em] text-outline font-bold group-focus-within:text-primary transition-colors font-sans">
                    Tên danh mục phân loại <span class="text-red-600">*</span>
                </label>
                <input asp-for="Name" autocomplete="new-password" class="w-full bg-transparent border border-outline-variant focus:border-primary rounded-lg py-3 px-4 font-sans text-sm font-semibold text-on-background focus:ring-0 outline-none transition-colors placeholder:text-outline-variant/60" placeholder="Ví dụ: Kiệt tác Nhẫn, Chuỗi Dây Chuyền..." required />
                <span asp-validation-for="Name" class="text-xs font-bold text-error mt-1 block font-sans"></span>
            </div>

            <div class="bg-surface-container-low/60 p-6 rounded-xl border border-outline-variant/30 mt-6 space-y-4">
                <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-3 border-b border-outline-variant/20 pb-3">
                    <div>
                        <h3 class="font-sans text-xs font-bold uppercase text-primary tracking-widest m-0">
                            Cập nhật bộ khung kích cỡ (Size)
                        </h3>
                        <p class="text-[11px] text-on-surface-variant font-sans font-medium m-0 mt-0.5">Thêm, sửa hoặc loại bỏ các kích cỡ áp dụng. Những size đang liên kết với sản phẩm thực tế sẽ được bảo vệ.</p>
                    </div>

                    <button type="button" onclick="addNewSizeRow()" class="px-3 py-1.5 bg-on-background text-white text-[11px] font-bold uppercase tracking-wider rounded-md hover:bg-primary transition-all border-none outline-none cursor-pointer flex items-center gap-1 w-fit font-sans">
                        <span class="material-symbols-outlined text-xs">add</span> Thêm ô Size
                    </button>
                </div>

                <div id="size-inputs-wrapper" class="space-y-3 max-h-[250px] overflow-y-auto pr-2">
                    @if (oldSizes.Any())
                    {
                        for (int i = 0; i < oldSizes.Count; i++)
                        {
                            <div class="flex items-center gap-3 size-input-item animate-fadeIn">
                                <div class="flex items-center gap-2 border border-outline-variant focus-within:border-primary w-full sm:w-[450px] rounded-lg px-3 py-1 bg-transparent transition-colors">
                                    <span class="material-symbols-outlined text-sm text-outline-variant">straighten</span>
                                    <input type="text" name="categorySizes[@i]" value="@oldSizes[i]" class="w-full border-none p-1.5 text-xs font-bold text-on-background bg-transparent focus:ring-0 outline-none font-sans" maxlength="100" required />
                                </div>
                                <button type="button" onclick="removeSizeRow(this)" class="text-outline-variant hover:text-red-600 bg-transparent border-none cursor-pointer flex items-center outline-none transition-colors">
                                    <span class="material-symbols-outlined text-lg">delete</span>
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="flex items-center gap-3 size-input-item animate-fadeIn">
                            <div class="flex items-center gap-2 border border-outline-variant focus-within:border-primary w-full sm:w-[450px] rounded-lg px-3 py-1 bg-transparent transition-colors">
                                <span class="material-symbols-outlined text-sm text-outline-variant">straighten</span>
                                <input type="text" name="categorySizes[0]" class="w-full border-none p-1.5 text-xs font-bold text-on-background bg-transparent focus:ring-0 outline-none font-sans" placeholder="Ví dụ: Size 10 hoặc 45 cm" maxlength="100" required />
                            </div>
                            <button type="button" onclick="removeSizeRow(this)" class="text-outline-variant hover:text-red-600 bg-transparent border-none cursor-pointer flex items-center outline-none transition-colors">
                                <span class="material-symbols-outlined text-lg">delete</span>
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="pt-4 border-t border-outline-variant/20 flex flex-col sm:flex-row gap-4 items-center">
                <button type="submit" class="w-full sm:w-auto px-10 py-3.5 bg-primary text-on-primary font-sans text-xs uppercase tracking-widest rounded-lg transition-all duration-300 active:scale-[0.98] hover:bg-opacity-90 border-none outline-none shadow-md shadow-primary/10 font-bold cursor-pointer">
                    Cập Nhật Danh Mục
                </button>
                <a asp-action="Index" class="w-full sm:w-auto px-10 py-3.5 border border-outline-variant text-on-surface font-sans text-xs uppercase tracking-widest rounded-lg hover:bg-surface-container-low text-center no-underline transition-all font-bold flex items-center justify-center bg-transparent box-border">
                    Hủy Bỏ & Quay Lại
                </a>
            </div>
        </form>
    </div>
</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Thiết lập chỉ mục tiếp theo nối tiếp tổng số lượng size cũ đang hiển thị trên UI
        let sizeIndex = document.querySelectorAll(".size-input-item").length;

        function addNewSizeRow() {
            const wrapper = document.getElementById("size-inputs-wrapper");

            const div = document.createElement("div");
            div.className = "flex items-center gap-3 size-input-item animate-fadeIn";

            div.innerHTML = `
                <div class="flex items-center gap-2 border border-outline-variant focus-within:border-primary w-full sm:w-[450px] rounded-lg px-3 py-1 bg-transparent transition-colors">
                    <span class="material-symbols-outlined text-sm text-outline-variant">straighten</span>
                    <input type="text" name="categorySizes[${sizeIndex}]" class="w-full border-none p-1.5 text-xs font-bold text-on-background bg-transparent focus:ring-0 outline-none font-sans" placeholder="Nhập tên kích cỡ..." maxlength="100" required />
                </div>
                <button type="button" onclick="removeSizeRow(this)" class="text-outline-variant hover:text-red-600 bg-transparent border-none cursor-pointer flex items-center outline-none transition-colors">
                    <span class="material-symbols-outlined text-lg">delete</span>
                </button>
            `;

            wrapper.appendChild(div);
            sizeIndex++;

            wrapper.scrollTop = wrapper.scrollHeight;
        }

        function removeSizeRow(button) {
            const row = button.closest(".size-input-item");
            if (row) {
                row.remove();
                reIndexSizeInputs(); // Đánh lại chỉ mục mảng liên tục (0,1,2,3) để C# gán dữ liệu chuẩn xác
            }
        }

        function reIndexSizeInputs() {
            const items = document.querySelectorAll(".size-input-item input[type='text']");
            sizeIndex = 0;
            items.forEach((input) => {
                input.name = `categorySizes[${sizeIndex}]`;
                sizeIndex++;
            });
        }

        // Logic điều khiển ẩn/hiện hộp thông báo lỗi động
        document.addEventListener('DOMContentLoaded', () => {
            const valSummary = document.getElementById('categoryEditValidationSummary');
            if (valSummary) {
                const hasErrors = valSummary.querySelectorAll('li').length > 0;
                if (hasErrors) {
                    valSummary.classList.remove('hidden');
                } else {
                    valSummary.classList.add('hidden');
                }
            }
        });
    </script>
}