@model AliceShop.Models.Category

@{
    ViewData["Title"] = "Xác nhận xóa danh mục";
}

<main class="pt-12 pb-20 max-w-[1440px] mx-auto px-6 md:px-20 animate-fadeIn">
    <header class="mb-12 border-b border-error/20 pb-6">
        <span class="text-xs font-bold text-error uppercase tracking-widest block mb-1">Cảnh báo hành động hệ thống</span>
        <h1 class="font-serif text-3xl md:text-4xl text-on-surface mb-2 font-medium tracking-wide">Xóa bỏ danh mục nhóm?</h1>
        <p class="text-secondary font-sans text-sm">Hành động này sẽ gỡ bỏ vĩnh viễn phân loại danh mục này khỏi hệ thống cơ sở dữ liệu SQL Server.</p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-8 bg-surface-container-low p-8 rounded-lg border border-outline-variant/20 shadow-sm space-y-6">
            <div>
                <span class="font-semibold text-xs uppercase tracking-widest text-on-surface-variant block mb-1">Tên danh mục phân loại</span>
                <h2 class="font-serif text-2xl font-medium text-on-surface uppercase tracking-wide m-0">@Model?.Name</h2>
            </div>

            <div class="pt-4 border-t border-outline-variant/20 font-sans text-xs text-secondary space-y-1">
                <p class="m-0 font-mono">MÃ ĐỊNH DANH HỆ THỐNG: #@Model?.Id</p>
            </div>
        </div>

        <div class="lg:col-span-4 space-y-6 bg-white p-6 rounded-lg border border-outline-variant/30 shadow-sm">
            <div class="space-y-3">
                <h3 class="text-xs font-bold uppercase tracking-widest text-error flex items-center gap-1 m-0">
                    <span class="material-symbols-outlined text-base">warning</span> Lưu ý quan trọng
                </h3>
                <p class="text-xs text-on-surface-variant leading-relaxed text-justify m-0 font-medium">
                    Việc xóa danh mục cha này yêu cầu hệ thống phải xử lý toàn bộ các sản phẩm con thuộc nhóm. Để tránh lỗi xung đột ràng buộc khóa ngoại (<span class="font-mono text-red-700">Foreign Key Constraint</span>) trong SQL Server, hãy chắc chắn bạn đã xử lý hoặc chuyển nhóm các sản phẩm liên quan trước khi thực hiện.
                </p>
            </div>

            <form asp-action="Delete" class="pt-4 flex flex-col gap-3 border-t border-outline-variant/20">
                <input type="hidden" asp-for="Id" />

                <button type="submit" class="w-full h-12 text-white font-semibold text-xs uppercase tracking-widest rounded-md transition-all duration-300 flex items-center justify-center gap-2 shadow-sm cursor-pointer border border-transparent outline-none hover:opacity-90" style="background-color: #ba1a1a;">
                    <span class="material-symbols-outlined text-sm">delete_forever</span> Xóa danh mục
                </button>

                <a asp-action="Index" class="w-full h-12 border border-outline text-on-surface font-semibold text-xs uppercase tracking-widest rounded-md hover:bg-surface-container text-center no-underline transition-colors flex items-center justify-center">
                    Hủy bỏ & Quay lại
                </a>
            </form>
        </div>
    </div>
</main>