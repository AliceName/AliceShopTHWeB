@model AliceShop.Models.Category

@{
    ViewData["Title"] = "Thêm danh mục mới";
}

<main class="pt-12 pb-20 max-w-[1440px] mx-auto px-6 md:px-20 animate-fadeIn">
    <header class="mb-12">
        <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-1">Chế độ quản trị viên</span>
        <h1 class="font-serif text-3xl md:text-4xl text-on-surface mb-2 font-medium tracking-wide">Khởi tạo danh mục</h1>
        <p class="text-secondary font-sans text-sm">Thêm mới các nhóm phân loại phân khúc nhằm tổ chức hệ thống bộ sưu tập trang sức cao cấp một cách khoa học.</p>
    </header>

    <div class="max-w-2xl bg-surface-container-low p-8 md:p-10 rounded-lg border border-outline-variant/20 shadow-sm">
        <form asp-action="Create" method="post" autocomplete="off" class="space-y-8">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 p-3 rounded border border-red-200 hidden"></div>

            <div class="space-y-2">
                <label asp-for="Name" class="font-semibold text-xs uppercase tracking-widest text-on-surface-variant block mb-1">
                    Tên danh mục phân loại <span class="text-red-600">*</span>
                </label>
                <input asp-for="Name" class="w-full input-underline py-3 px-0 text-lg font-serif text-on-surface bg-transparent focus:ring-0 focus:outline-none" placeholder="Ví dụ: Kiệt tác Nhẫn, Chuỗi Dây Chuyền, Vòng Lắc Tay..." required />
                <span asp-validation-for="Name" class="text-red-600 text-xs font-semibold mt-1 block"></span>
            </div>

            <div class="pt-6 flex flex-col sm:flex-row gap-4 items-center">
                <button type="submit" class="w-full sm:w-auto px-12 py-4 bg-on-background text-white font-semibold text-xs uppercase tracking-widest rounded-md hover:bg-primary transition-colors shadow-sm cursor-pointer outline-none">
                    Khởi Tạo Danh Mục
                </button>
                <a asp-action="Index" class="w-full sm:w-auto px-12 py-4 border border-outline text-on-surface font-semibold text-xs uppercase tracking-widest rounded-md hover:bg-surface-container text-center no-underline transition-colors flex items-center justify-center">
                    Hủy Bỏ & Quay Lại
                </a>
            </div>
        </form>
    </div>
</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}