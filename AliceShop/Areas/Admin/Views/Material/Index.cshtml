@model IEnumerable<AliceShop.Models.Material>

@{
    ViewData["Title"] = "Quản lý chất liệu";
}

<div class="max-w-[1440px] mx-auto px-6 md:px-20 py-10 animate-fadeIn">

    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-12">
        <div>
            <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-1">Bảng điều khiển Admin</span>
            <h1 class="font-sans font-bold text-2xl md:text-3xl text-on-surface m-0 tracking-wide">Quản lý chất liệu</h1>
            <p class="text-on-surface-variant text-sm mt-1">Hệ thống hiển thị dạng thẻ cao cấp - Quản lý sản phẩm dễ dàng</p>
        </div>
        <a asp-action="Create" class="inline-flex items-center gap-2 bg-primary text-white font-semibold text-xs uppercase tracking-widest px-6 py-3.5 rounded-md hover:bg-opacity-90 transition-all duration-300 no-underline shadow-sm">
            <span class="material-symbols-outlined text-sm">add</span> Thêm chất liệu mới
        </a>
    </div>

    <div class="bg-white border border-outline-variant/30 rounded-xl overflow-hidden shadow-[0_4px_20px_rgba(0,0,0,0.01)]">
        <div class="overflow-x-auto">
            <table class="w-full border-collapse text-left m-0">
                <thead>
                    <tr class="bg-surface-container-low border-b border-outline-variant/30 text-on-surface-variant font-semibold text-xs uppercase tracking-widest">
                        <th class="py-4 px-6 font-semibold w-24">Mã ID</th>
                        <th class="py-4 px-6 font-semibold">Tên chất liệu / Nguyên liệu quý</th>
                        <th class="py-4 px-6 font-semibold text-right w-48">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant/20 font-sans text-sm text-on-surface">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-surface-container-low/30 transition-colors duration-150">
                            <td class="py-4 px-6 font-mono text-xs text-secondary font-bold">
                                #@item.Id
                            </td>
                            <td class="py-4 px-6">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary text-lg">diamond</span>
                                    <span class="font-sans font-semibold text-sm tracking-wide text-on-surface">@item.Name</span>
                                </div>
                            </td>
                            <td class="py-4 px-6 text-right">
                                <div class="inline-flex items-center bg-surface-container-low p-1 rounded-md border border-outline-variant/30 shadow-inner gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="w-8 h-8 rounded flex items-center justify-center text-on-surface-variant hover:bg-white hover:text-amber-600 transition-all duration-200 no-underline" title="Chỉnh sửa">
                                        <span class="material-symbols-outlined text-lg">edit</span>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="w-8 h-8 rounded flex items-center justify-center text-on-surface-variant hover:bg-white hover:text-red-600 transition-all duration-200 no-underline" title="Xóa">
                                        <span class="material-symbols-outlined text-lg">delete</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="py-24 text-center text-on-surface-variant/60 italic text-sm border border-dashed rounded-xl border-outline-variant/50 mt-6 bg-white/50">
            <span class="material-symbols-outlined text-4xl block mb-3 text-outline-variant">layers_clear</span>Hiện không có chất liệu nào trong cơ sở dữ liệu.
        </div>
    }
</div>