@model IEnumerable<AliceShop.Models.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
    var categories = ViewBag.CategoriesList as IEnumerable<AliceShop.Models.Category> ?? new List<AliceShop.Models.Category>();
}

<div class="max-w-[1440px] mx-auto px-6 md:px-20 py-10 animate-fadeIn">

    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-12">
        <div>
            <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-1">Bảng điều khiển Admin</span>
            <h1 class="font-serif text-3xl font-medium text-on-background">Quản lý sản phẩm</h1>
            <p class="text-on-surface-variant text-sm mt-1">Hệ thống hiển thị dạng thẻ cao cấp - Quản lý sản phẩm dễ dàng</p>
        </div>
        <a asp-action="Create" class="inline-flex items-center gap-2 bg-primary text-white font-semibold text-xs uppercase tracking-widest px-6 py-3.5 rounded-md hover:bg-opacity-90 transition-all duration-300 no-underline shadow-sm">
            <span class="material-symbols-outlined text-sm">add</span> Thêm sản phẩm mới
        </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-8">
        @foreach (var item in Model)
        {
            // ĐỒNG BỘ ẢNH QUAN HỆ 1-N: Ưu tiên bốc ImageUrl chính, nếu null bốc ảnh đầu tiên từ bảng Images con
            var displayImageUrl = "/images/placeholder.png";
            if (!string.IsNullOrEmpty(item.ImageUrl))
            {
                displayImageUrl = item.ImageUrl;
            }
            else if (item.Images != null && item.Images.Any())
            {
                displayImageUrl = item.Images.First().Url;
            }

            var currentCategoryName = categories.FirstOrDefault(c => c.Id == item.CategoryId)?.Name ?? "Trang sức";

            <div class="bg-white border border-outline-variant/40 rounded-xl overflow-hidden shadow-[0_4px_20px_rgba(0,0,0,0.02)] flex flex-col justify-between group transition-all duration-300 hover:shadow-md">
                <div>
                    <div class="relative aspect-[4/5] bg-surface-container-low overflow-hidden border-b border-outline-variant/20">
                        <img src="@displayImageUrl" class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-500" alt="@item.Name" loading="lazy" />
                        <span class="absolute top-3 left-3 bg-on-background/80 text-white font-mono text-[10px] px-2 py-0.5 rounded backdrop-blur-sm tracking-wider">ID: #@item.Id</span>
                    </div>

                    <div class="p-5 space-y-3">
                        <span class="inline-flex items-center gap-1 bg-primary/5 text-primary text-[11px] px-2 py-1 rounded font-semibold tracking-wide border border-primary/10">
                            <span class="material-symbols-outlined text-[13px]">sell</span> @currentCategoryName
                        </span>
                        <h3 class="font-semibold text-on-background text-sm tracking-wide uppercase line-clamp-1 m-0" title="@item.Name">@item.Name</h3>
                        <p class="font-sans text-sm font-bold text-red-800 m-0">@string.Format("{0:N0} đ", item.Price)</p>
                        <p class="text-on-surface-variant/80 text-xs leading-relaxed line-clamp-2 pt-1 border-t border-outline-variant/20 m-0" style="text-align: justify;">@item.Description</p>
                    </div>
                </div>

                <div class="px-5 pb-5 pt-2 border-t border-outline-variant/10 bg-surface-container-low/20">
                    <div class="grid grid-cols-3 gap-2 bg-surface-container-low p-1 rounded-lg border border-outline-variant/30 shadow-inner">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="rounded-md py-1.5 flex items-center justify-center text-on-surface-variant hover:bg-white hover:text-amber-600 transition-all duration-200 no-underline"><span class="material-symbols-outlined text-lg">edit</span></a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="rounded-md py-1.5 flex items-center justify-center text-on-surface-variant hover:bg-white hover:text-sky-600 transition-all duration-200 no-underline"><span class="material-symbols-outlined text-lg">visibility</span></a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="rounded-md py-1.5 flex items-center justify-center text-on-surface-variant hover:bg-white hover:text-red-600 transition-all duration-200 no-underline"><span class="material-symbols-outlined text-lg">delete</span></a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="py-24 text-center text-on-surface-variant/60 italic text-sm border border-dashed rounded-xl border-outline-variant/50 mt-6 bg-white/50">
            <span class="material-symbols-outlined text-4xl block mb-3 text-outline-variant">inventory_2</span>Hiện không có sản phẩm nào trong cơ sở dữ liệu.
        </div>
    }
</div>