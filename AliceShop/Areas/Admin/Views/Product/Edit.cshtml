@model AliceShop.Models.Product

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
    var mainImgUrl = string.IsNullOrEmpty(Model?.ImageUrl) ? "/images/placeholder.png" : Model.ImageUrl;
}

<main class="pt-12 pb-20 max-w-[1440px] mx-auto px-6 md:px-20 animate-fadeIn">
    <header class="mb-12">
        <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-1">Chế độ quản trị viên</span>
        <h1 class="font-serif text-3xl md:text-4xl text-on-surface mb-2 font-medium tracking-wide">Chỉnh sửa tác phẩm</h1>
        <p class="text-secondary font-sans text-sm">Cập nhật thông số, hình ảnh và phân loại cho sản phẩm mã số #@Model.Id.</p>
    </header>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="grid grid-cols-1 lg:grid-cols-12 gap-12" autocomplete="off">
        <div asp-validation-summary="ModelOnly" class="col-span-12 text-sm text-red-600 bg-red-50 p-3 rounded border border-red-200 hidden"></div>
        <input type="hidden" asp-for="Id" />

        <div class="lg:col-span-5 space-y-8">
            <div class="bg-surface-container-low p-6 rounded-lg border border-outline-variant/20 shadow-sm">
                <label class="font-semibold text-xs uppercase tracking-widest mb-4 block text-on-surface-variant">Ảnh đại diện chính</label>
                <div class="relative aspect-[4/5] w-full border-2 border-dashed border-outline-variant hover:border-primary transition-colors flex flex-col items-center justify-center cursor-pointer group bg-white rounded-lg overflow-hidden" id="drop-zone-main">
                    <img src="@mainImgUrl" id="main-preview-img" class="absolute inset-0 w-full h-full object-cover rounded-md">
                    <div class="absolute inset-0 bg-on-surface/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center rounded-md">
                        <span class="material-symbols-outlined text-white" style="font-size: 32px;">edit</span>
                    </div>
                    <input type="file" name="imageFiles" id="main-image-input" accept="image/*" class="hidden" />
                </div>
            </div>

            <div class="bg-surface-container-low p-6 rounded-lg border border-outline-variant/20 shadow-sm">
                <label class="font-semibold text-xs uppercase tracking-widest mb-2 block text-on-surface-variant">Album ảnh phụ hiện tại</label>
                <p class="text-xs text-secondary mb-4">Nhấp vào biểu tượng thùng rác trên từng hình để đánh dấu xóa khỏi SQL Server.</p>

                <div class="grid grid-cols-3 gap-4 mb-6">
                    @if (Model.Images != null && Model.Images.Any())
                    {
                        foreach (var img in Model.Images)
                        {
                            <div class="relative aspect-square border border-outline-variant/40 rounded bg-white p-0.5 group overflow-hidden photo-sub-card" id="img-container-@img.Id">
                                <img src="@img.Url" class="w-full h-full object-cover rounded-sm" />
                                <button type="button" onclick="markImageForDeletion(@img.Id)" class="absolute inset-0 bg-red-900/80 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white outline-none">
                                    <span class="material-symbols-outlined">delete</span>
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-span-3 py-6 text-center text-xs italic text-secondary border border-dashed rounded bg-white/50">
                            Chưa có ảnh phụ nào được lưu.
                        </div>
                    }
                </div>

                <label class="font-semibold text-xs uppercase tracking-widest mb-3 block text-on-surface-variant">Tải lên thêm ảnh góc chụp mới</label>
                <div class="relative w-full border-2 border-dashed border-outline-variant hover:border-primary transition-colors flex flex-col items-center justify-center cursor-pointer group bg-white rounded-lg py-6" id="drop-zone-gallery">
                    <span class="material-symbols-outlined text-outline-variant group-hover:text-primary mb-1">add_photo_alternate</span>
                    <p class="text-center text-xs text-secondary font-medium m-0">Bấm để đăng tải thêm ảnh phụ</p>
                    <input type="file" name="imageFiles" id="gallery-images-input" accept="image/*" multiple class="hidden" />
                </div>
                <div id="deletion-inputs-container"></div>
                <div class="grid grid-cols-4 gap-3 mt-4" id="gallery-preview-container"></div>
            </div>
        </div>

        <div class="lg:col-span-7 space-y-10">
            <section class="space-y-8">
                <div>
                    <label asp-for="Name" class="font-semibold text-xs uppercase tracking-widest text-on-surface-variant block mb-2">Tên sản phẩm trang sức <span class="text-red-600">*</span></label>
                    <input asp-for="Name" class="w-full input-underline py-3 px-0 text-lg font-serif text-on-surface" placeholder="Ví dụ: Nhẫn Kim Cương Eternal Glow" required />
                    <span asp-validation-for="Name" class="text-red-600 text-xs font-semibold mt-1 block"></span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div>
                        <label asp-for="CategoryId" class="font-semibold text-xs uppercase tracking-widest text-on-surface-variant block mb-2">Phân loại danh mục <span class="text-red-600">*</span></label>
                        <div class="relative border-b border-[#d1c5b4]">
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="w-full border-none bg-transparent py-3 px-0 text-sm text-on-surface cursor-pointer focus:ring-0 focus:outline-none" required>
                            </select>
                            <span class="material-symbols-outlined absolute right-0 top-3 pointer-events-none text-on-surface-variant">expand_more</span>
                        </div>
                        <span asp-validation-for="CategoryId" class="text-red-600 text-xs font-semibold mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="MaterialId" class="font-semibold text-xs uppercase tracking-widest text-on-surface-variant block mb-2">Chất liệu chế tác <span class="text-red-600">*</span></label>
                        <div class="relative border-b border-[#d1c5b4]">
                            <select asp-for="MaterialId" asp-items="ViewBag.Materials" class="w-full border-none bg-transparent py-3 px-0 text-sm text-on-surface cursor-pointer focus:ring-0 focus:outline-none" required>
                            </select>
                            <span class="material-symbols-outlined absolute right-0 top-3 pointer-events-none text-on-surface-variant">expand_more</span>
                        </div>
                        <span asp-validation-for="MaterialId" class="text-red-600 text-xs font-semibold mt-1 block"></span>
                    </div>
                </div>

                <div>
                    <label class="font-semibold text-xs uppercase tracking-widest text-on-surface-variant block mb-2">
                        Giá niêm yết bán lẻ (VNĐ) <span class="text-red-600">*</span>
                    </label>

                    <input type="text" id="price-display" class="w-full input-underline py-3 px-0 text-lg font-sans text-primary font-bold focus:ring-0 focus:outline-none" placeholder="0" required />

                    <input type="hidden" asp-for="Price" id="price-actual" />

                    <span asp-validation-for="Price" class="text-red-600 text-xs font-semibold mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Description" class="font-semibold text-xs uppercase tracking-widest text-on-surface-variant block mb-2">Mô tả câu chuyện & thông số chi tiết</label>
                    <textarea asp-for="Description" class="w-full input-underline py-3 px-0 text-sm text-on-surface resize-none font-medium text-justify" rows="6" placeholder="Nhập mô tả cảm hứng chế tác..."></textarea>
                    <span asp-validation-for="Description" class="text-red-600 text-xs font-semibold mt-1 block"></span>
                </div>
            </section>

            <div class="pt-8 flex flex-col sm:flex-row gap-4 items-center">
                <button class="w-full sm:w-auto px-12 py-4 bg-on-background text-white font-semibold text-xs uppercase tracking-widest rounded-md hover:bg-primary transition-colors shadow-sm cursor-pointer" type="submit">
                    Cập Nhật Tác Phẩm
                </button>
                <a asp-action="Index" class="w-full sm:w-auto px-12 py-4 border border-outline text-on-surface font-semibold text-xs uppercase tracking-widest rounded-md hover:bg-surface-container text-center no-underline transition-colors">
                    Hủy Cập Nhật
                </a>
            </div>
        </div>
    </form>
</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // 1. Xử lý tương tác thay đổi/Đăng tải ảnh đại diện chính mới
        const dropZoneMain = document.getElementById('drop-zone-main');
        const mainInput = document.getElementById('main-image-input');
        const mainPreview = document.getElementById('main-preview-img');

        dropZoneMain.addEventListener('click', () => mainInput.click());
        mainInput.addEventListener('change', (e) => {
            if (e.target.files.length > 0) {
                const file = e.target.files[0];
                if (file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = (ev) => {
                        mainPreview.src = ev.target.result;
                    };
                    reader.readAsDataURL(file);
                }
            }
        });

        // 2. Xử lý xóa mềm ảnh phụ cũ ngay trên UI và đẩy ID vào mảng gửi lên Controller
        const deletionContainer = document.getElementById('deletion-inputs-container');
        function markImageForDeletion(imageId) {
            if (confirm("Bạn có chắc chắn muốn loại bỏ vĩnh viễn tấm ảnh phụ này?")) {
                // Ẩn khối card ảnh trên UI
                const targetCard = document.getElementById(`img-container-${imageId}`);
                if (targetCard) targetCard.remove();

                // Sinh thẻ input hidden gửi lên biến List<int>? removedImageIds của Controller
                const hiddenInput = document.createElement('input');
                hiddenInput.type = 'hidden';
                hiddenInput.name = 'removedImageIds';
                hiddenInput.value = imageId;
                deletionContainer.appendChild(hiddenInput);
            }
        }

        // 3. Preview danh sách ảnh phụ mới chuẩn bị upload thêm
        const dropZoneGallery = document.getElementById('drop-zone-gallery');
        const galleryInput = document.getElementById('gallery-images-input');
        const previewContainer = document.getElementById('gallery-preview-container');

        dropZoneGallery.addEventListener('click', () => galleryInput.click());
        galleryInput.addEventListener('change', (e) => {
            previewContainer.innerHTML = ''; // Làm sạch đợt preview trước
            Array.from(e.target.files).forEach(file => {
                if (file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = (ev) => {
                        const div = document.createElement('div');
                        div.className = "aspect-square border border-outline-variant/40 rounded overflow-hidden bg-white p-0.5 shadow-sm";
                        div.innerHTML = `<img src="${ev.target.result}" class="w-full h-full object-cover rounded-sm" />`;
                        previewContainer.appendChild(div);
                    };
                    reader.readAsDataURL(file);
                }
            });
        });

        // Thêm đoạn này vào bên trong vùng <script> dưới đáy trang Edit.cshtml của bạn
        document.addEventListener("DOMContentLoaded", function () {
            const priceDisplay = document.getElementById("price-display");
            const priceActual = document.getElementById("price-actual");

            // 1. Hàm định dạng số thành chuỗi có dấu chấm phân cách (1000 -> 1.000)
            function formatVND(value) {
                if (!value) return "";
                return value.toString().replace(/\D/g, "").replace(/\B(?=(\d{3})+(?!\d))/g, ".");
            }

            // 2. Khi trang vừa tải: Đọc giá trị số cũ từ Model ra để hiển thị dạng VND lên input hiển thị
            if (priceActual && priceActual.value) {
                priceDisplay.value = formatVND(priceActual.value);
            }

            // 3. Khi Admin gõ phím thay đổi giá tiền
            priceDisplay.addEventListener("input", function (e) {
                // Loại bỏ mọi ký tự không phải là số
                let rawValue = e.target.value.replace(/\D/g, "");

                // Lưu giá trị số nguyên chất vào input ẩn để gửi về SQL Server
                priceActual.value = rawValue;

                // Cập nhật lại chuỗi hiển thị có dấu chấm phân cách lên màn hình
                e.target.value = formatVND(rawValue);
            });
        });
    </script>
}