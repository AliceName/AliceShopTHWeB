@model AliceShop.Models.UserVM

@{
    ViewData["Title"] = "Chỉnh sửa Vai trò Người dùng";
}

<main class="pt-12 pb-20 max-w-[1440px] mx-auto px-6 md:px-20 animate-fadeIn">
    <header class="mb-12">
        <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-1">Chế độ quản trị viên</span>
        <h1 class="font-sans text-2xl md:text-3xl font-bold text-on-surface mb-2 tracking-wide">Phân Quyền: @Model.User.FullName</h1>
        <p class="text-secondary font-sans text-sm">Chỉ định quyền hạn mới cho thành viên trong hệ thống.</p>
    </header>

    <div class="max-w-xl">
        <form asp-action="EditRole" method="post" class="space-y-8 bg-surface-container-low p-6 rounded-lg border border-outline-variant/30 shadow-sm" autocomplete="off">
            <input type="hidden" asp-for="User.Id" />
            
            <div class="space-y-4">
                <div>
                    <label class="font-bold text-xs uppercase tracking-widest text-on-surface-variant block mb-2 font-sans">
                        Email Đăng Nhập
                    </label>
                    <input type="text" value="@Model.User.Email" class="w-full input-underline py-3 px-0 text-base font-sans text-on-surface-variant font-medium bg-transparent cursor-not-allowed border-b-outline-variant/30" disabled />
                </div>

                <div>
                    <label asp-for="Role" class="font-bold text-xs uppercase tracking-widest text-on-surface block mb-2 font-sans">
                        Vai Trò (Role) Hiện Tại <span class="text-red-600">*</span>
                    </label>
                    <div class="relative border-b border-[#d1c5b4]">
                        <select asp-for="Role" asp-items="@Model.RoleList" class="w-full border-none bg-transparent py-3 px-0 text-sm text-on-surface font-sans font-semibold cursor-pointer focus:ring-0 focus:outline-none" required>
                            <option value="" disabled selected>-- Chọn quyền hạn --</option>
                        </select>
                        <span class="material-symbols-outlined absolute right-0 top-3 pointer-events-none text-on-surface-variant">expand_more</span>
                    </div>
                </div>
            </div>

            <div class="pt-4 flex flex-col sm:flex-row gap-4 items-center">
                <button class="w-full sm:w-auto px-12 py-4 bg-on-background text-white font-semibold text-xs uppercase tracking-widest rounded-md hover:bg-primary transition-colors shadow-sm cursor-pointer border border-transparent outline-none font-sans" type="submit">
                    Lưu Vai Trò
                </button>
                <a asp-action="Index" class="w-full sm:w-auto px-12 py-4 border border-outline text-on-surface font-semibold text-xs uppercase tracking-widest rounded-md hover:bg-surface-container text-center no-underline transition-colors flex items-center justify-center font-sans">
                    Quay Lại
                </a>
            </div>
        </form>
    </div>
</main>
