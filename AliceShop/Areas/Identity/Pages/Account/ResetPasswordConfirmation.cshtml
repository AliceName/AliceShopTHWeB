@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu thành công | AliceStore";
    // Kế thừa Layout chung của hệ thống để đồng bộ Navbar & Footer động
    Layout = "/Views/Shared/_Layout.cshtml";
}

<!-- CONTAINER BO GỌN GIỮA MÀN HÌNH (Khắc phục hoàn toàn lỗi tràn màn hình) -->
<main class="flex-grow pt-20 pb-32 px-margin-mobile md:px-margin-desktop max-w-xl mx-auto w-full animate-fadeIn">

    <!-- KHỐI CARD BIỂU MẪU TƯƠNG PHẢN CAO -->
    <div class="bg-white border border-outline-variant/30 rounded-xl p-8 md:p-12 shadow-[0_4px_20px_rgba(0,0,0,0.01)] text-center space-y-6">

        <!-- Icon chìa khóa tròn mềm mại màu vàng kim nổi bật -->
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-surface-container-low border border-outline-variant/20 text-primary mb-2">
            <span class="material-symbols-outlined text-[32px]">vpn_key</span>
        </div>

        <!-- Tiêu đề phân hệ cấu trúc Quiet Luxury -->
        <div class="space-y-1">
            <h2 class="font-serif text-2xl font-medium text-on-surface uppercase tracking-wide m-0">Đặt lại thành công</h2>
            <p class="text-xs text-primary font-bold uppercase tracking-[0.15em] m-0">Mật khẩu mới đã kích hoạt</p>
        </div>

        <!-- Nội dung chữ văn phong trang trọng, rõ nét -->
        <p class="font-sans text-sm text-on-surface-variant leading-relaxed text-center m-0 font-medium max-w-sm mx-auto">
            Mật khẩu tài khoản của bạn đã được cập nhật và bảo mật thành công trên hệ thống. Vui lòng sử dụng mật khẩu mới này cho các lần truy cập tiếp theo.
        </p>

        <!-- NÚT BẤM VÀNG KIM NỔI BẬT NỀN TRẮNG -->
        <div class="pt-6 border-t border-outline-variant/20">
            <a asp-page="./Login" class="w-full inline-flex items-center justify-center py-3.5 bg-primary text-on-primary font-label-md text-xs uppercase tracking-widest rounded-lg transition-all duration-300 active:scale-[0.98] hover:bg-opacity-90 no-underline shadow-md shadow-primary/10 font-bold outline-none border border-transparent">
                Đăng nhập tài khoản
            </a>
        </div>

    </div>
</main>