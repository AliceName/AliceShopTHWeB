@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Gửi yêu cầu thành công | AliceStore";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<main class="flex-grow pt-20 pb-32 px-margin-mobile md:px-margin-desktop max-w-xl mx-auto w-full animate-fadeIn">

    <div class="bg-white border border-outline-variant/30 rounded-xl p-8 md:p-12 shadow-[0_4px_20px_rgba(0,0,0,0.01)] text-center space-y-6">

        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-surface-container-low border border-outline-variant/20 text-primary mb-2">
            <span class="material-symbols-outlined text-[32px]">mail</span>
        </div>

        <div class="space-y-1">
            <h2 class="font-sans text-xl md:text-2xl font-bold text-on-surface uppercase tracking-wide m-0">Đã gửi yêu cầu</h2>
            <p class="text-xs text-primary font-bold uppercase tracking-[0.15em] m-0">Kiểm tra hộp thư điện tử</p>
        </div>

        <p class="font-sans text-sm text-on-surface-variant leading-relaxed text-center m-0 font-medium max-w-sm mx-auto">
            AliceStore đã tiếp nhận và gửi một liên kết khôi phục mật khẩu bảo mật đến địa chỉ thư điện tử của bạn. Vui lòng kiểm tra hộp thư đến (hoặc thư rác) để hoàn tất quy trình đặt lại mã khóa.
        </p>

        @if (!string.IsNullOrEmpty(Request.Query["tokenUrl"]))
        {
            <div class="p-5 bg-surface-container-low border border-dashed border-primary/30 rounded-xl space-y-3 animate-fadeIn text-left mt-4">
                <span class="text-[10px] uppercase tracking-[0.15em] text-primary font-bold block">Chế độ kiểm thử (Local Test Mode)</span>
                <p class="font-sans text-xs text-on-surface-variant m-0 font-medium leading-relaxed">
                    Hệ thống phát hiện bạn đang chạy thử nghiệm tại máy cục bộ và dịch vụ Mail thật đang tạm hoãn. Bấm vào nút vàng dưới đây để đổi mật mã trực tiếp:
                </p>
                <a href="@Request.Query["tokenUrl"]" class="w-full inline-flex items-center justify-center py-3 bg-primary text-on-primary font-label-md text-xs uppercase tracking-widest rounded-lg transition-all duration-300 active:scale-[0.98] hover:bg-opacity-90 no-underline shadow-sm font-bold border border-transparent">
                    Đặt lại mật khẩu luôn tại đây
                </a>
            </div>
        }

        <div class="pt-6 border-t border-outline-variant/20">
            <a asp-page="./Login" class="w-full inline-flex items-center justify-center py-3.5 border border-outline-variant text-on-surface font-label-md text-xs uppercase tracking-widest rounded-lg transition-all duration-300 active:scale-[0.98] hover:bg-surface-container-low no-underline font-bold bg-transparent">
                Quay lại đăng nhập
            </a>
        </div>

    </div>
</main>