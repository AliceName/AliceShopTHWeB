@page
@model RegisterModel
@{
    ViewData["Title"] = "Đăng ký tài khoản | AliceStore";
    // Kế thừa Layout chung của hệ thống để đồng bộ Navbar & Footer động
    Layout = "/Views/Shared/_Layout.cshtml";
}

<!-- CONTAINER BO GỌN GIỮA MÀN HÌNH (Khắc phục hoàn toàn lỗi tràn màn hình) -->
<main class="flex-grow pt-16 pb-24 px-margin-mobile md:px-margin-desktop max-w-xl mx-auto w-full animate-fadeIn">

    <!-- KHỐI CARD BIỂU MẪU TƯƠNG PHẢN CAO -->
    <div class="bg-white border border-outline-variant/30 rounded-xl p-8 md:p-12 shadow-[0_4px_20px_rgba(0,0,0,0.01)] space-y-8">

        <!-- Tiêu đề phân hệ cấu trúc Quiet Luxury -->
        <div class="space-y-2 text-center">
            <h2 class="font-serif text-2xl md:text-3xl font-medium text-on-surface uppercase tracking-wide m-0">Tạo tài khoản</h2>
            <p class="font-sans text-sm text-on-surface-variant m-0">
                Tham gia cùng AliceStore để trải nghiệm những bộ sưu tập đẳng cấp nhất.
            </p>
        </div>

        <!-- FORM POST ĐĂNG KÝ HỆ THỐNG GỐC -->
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="space-y-6">

            <!-- Hộp tóm tắt lỗi hệ thống từ SQL Server -->
            <div asp-validation-summary="ModelOnly" class="text-xs font-semibold text-error bg-error-container/20 border border-error/20 p-4 rounded-md animate-fadeIn" role="alert"></div>

            <!-- ✨ TRƯỜNG BỔ SUNG: Họ và tên (Cập nhật theo image_b6a243.png) -->
            <div class="space-y-1.5 group">
                <label asp-for="Input.FullName" class="block text-[10px] uppercase tracking-[0.15em] text-outline font-bold group-focus-within:text-primary transition-colors">Họ và tên <span class="text-error">*</span></label>
                <input asp-for="Input.FullName" class="w-full bg-transparent border border-outline-variant focus:border-primary rounded-lg py-3 px-4 font-sans text-sm font-semibold text-on-background focus:ring-0 outline-none transition-colors placeholder:text-outline-variant/40" placeholder="Nguyễn Văn A" required aria-required="true" />
                <span asp-validation-for="Input.FullName" class="text-xs font-bold text-error mt-1 block"></span>
            </div>

            <!-- Trường: Email -->
            <div class="space-y-1.5 group">
                <label asp-for="Input.Email" class="block text-[10px] uppercase tracking-[0.15em] text-outline font-bold group-focus-within:text-primary transition-colors">Địa chỉ Email <span class="text-error">*</span></label>
                <input asp-for="Input.Email" class="w-full bg-transparent border border-outline-variant focus:border-primary rounded-lg py-3 px-4 font-sans text-sm font-semibold text-on-background focus:ring-0 outline-none transition-colors placeholder:text-outline-variant/40" placeholder="example@@alice.store" required aria-required="true" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="text-xs font-bold text-error mt-1 block"></span>
            </div>

            <!-- Trường: Mật khẩu -->
            <div class="space-y-1.5 group">
                <label asp-for="Input.Password" class="block text-[10px] uppercase tracking-[0.15em] text-outline font-bold group-focus-within:text-primary transition-colors">Mật khẩu bảo mật <span class="text-error">*</span></label>
                <div class="relative rounded-lg border border-outline-variant group-focus-within:border-primary transition-colors overflow-hidden flex items-center bg-transparent">
                    <input asp-for="Input.Password" class="w-full bg-transparent border-none py-3 px-4 font-sans text-sm font-semibold text-on-background focus:ring-0 outline-none placeholder:text-outline-variant/40" placeholder="••••••••" required aria-required="true" autocomplete="new-password" />
                    <button class="text-on-surface-variant hover:text-primary transition-colors bg-transparent border-none py-0 px-4 outline-none cursor-pointer flex items-center h-full" type="button">
                        <span class="material-symbols-outlined text-xl">visibility</span>
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="text-xs font-bold text-error mt-1 block"></span>
            </div>

            <!-- Trường: Nhập lại mật khẩu -->
            <div class="space-y-1.5 group">
                <label asp-for="Input.ConfirmPassword" class="block text-[10px] uppercase tracking-[0.15em] text-outline font-bold group-focus-within:text-primary transition-colors">Nhập lại mật khẩu <span class="text-error">*</span></label>
                <div class="relative rounded-lg border border-outline-variant group-focus-within:border-primary transition-colors overflow-hidden flex items-center bg-transparent">
                    <input asp-for="Input.ConfirmPassword" class="w-full bg-transparent border-none py-3 px-4 font-sans text-sm font-semibold text-on-background focus:ring-0 outline-none placeholder:text-outline-variant/40" placeholder="••••••••" required aria-required="true" autocomplete="new-password" />
                    <button class="text-on-surface-variant hover:text-primary transition-colors bg-transparent border-none py-0 px-4 outline-none cursor-pointer flex items-center h-full" type="button">
                        <span class="material-symbols-outlined text-xl">visibility</span>
                    </button>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-xs font-bold text-error mt-1 block"></span>
            </div>
            <div class="space-y-1.5 group">
                <label asp-for="Input.Role" class="block text-[10px] uppercase tracking-[0.15em] text-outline font-bold group-focus-within:text-primary transition-colors">Vai trò tài khoản <span class="text-error">*</span></label>
                <div class="relative rounded-lg border border-outline-variant group-focus-within:border-primary transition-colors overflow-hidden bg-transparent">
                    <select asp-for="Input.Role" asp-items="@Model.Input.RoleList" class="w-full bg-transparent border-none py-3 px-4 font-sans text-sm font-semibold text-on-background focus:ring-0 outline-none cursor-pointer appearance-none">
                        <option value="" disabled selected class="text-outline/40">-- Lựa chọn nhóm đặc quyền --</option>
                    </select>
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-on-surface-variant">
                        <span class="material-symbols-outlined text-base">expand_more</span>
                    </div>
                </div>
                <span asp-validation-for="Input.Role" class="text-xs font-bold text-error mt-1 block"></span>
            </div>

            <!-- Cam kết điều khoản ẩn -->
            <div class="flex items-start gap-3 py-2">
                <div class="relative flex items-center h-5 mt-0.5">
                    <input class="w-4 h-4 rounded-sm border-outline-variant text-primary focus:ring-primary/20 transition-all cursor-pointer" id="terms" required type="checkbox" />
                </div>
                <label class="font-sans text-xs font-medium text-on-surface-variant leading-normal cursor-pointer select-none" for="terms">
                    Tôi đồng ý với các <a class="text-primary hover:underline underline-offset-4 font-semibold no-underline" href="#">điều khoản dịch vụ</a> và <a class="text-primary hover:underline underline-offset-4 font-semibold no-underline" href="#">chính sách bảo mật</a> của AliceStore.
                </label>
            </div>

            <!-- NÚT BẤM VÀNG KIM NỔI BẬT NỀN TRẮNG -->
            <div class="pt-2">
                <button id="registerSubmit" type="submit" class="w-full inline-flex items-center justify-center py-3.5 bg-primary text-on-primary font-label-md text-xs uppercase tracking-widest rounded-lg transition-all duration-300 active:scale-[0.98] hover:bg-opacity-90 border-none outline-none shadow-md shadow-primary/10 font-bold cursor-pointer">
                    Đăng ký tài khoản
                </button>
            </div>
        </form>

        <!-- Khối hiển thị bên thứ 3 (External Logins) đồng bộ từ file gốc của bạn -->
        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="space-y-4">
                <div class="flex items-center justify-center gap-4">
                    <div class="h-px bg-outline-variant/20 flex-1"></div>
                    <span class="font-label-md text-[11px] text-on-surface-variant/50 tracking-wider">HOẶC ĐĂNG KÝ BẰNG</span>
                    <div class="h-px bg-outline-variant/20 flex-1"></div>
                </div>
                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="flex flex-col gap-2">
                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        <button type="submit" class="w-full py-3 border border-outline-variant text-on-surface font-label-md text-xs uppercase tracking-widest rounded-lg hover:bg-surface-container-low transition-all cursor-pointer bg-transparent outline-none" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                            @provider.DisplayName
                        </button>
                    }
                </form>
            </div>
        }

        <!-- Lối lui chuyển tuyến đăng nhập nhanh -->
        <div class="text-center border-t border-outline-variant/20 pt-4">
            <p class="font-sans text-sm text-on-surface-variant m-0">
                Đã có tài khoản thành viên?
                <a class="text-primary font-bold hover:underline underline-offset-4 decoration-1 ml-1 transition-all no-underline" asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Đăng nhập ngay</a>
            </p>
        </div>

    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Logic ẩn/hiện mật khẩu bằng eye icon mượt mà
            document.querySelectorAll('button[type="button"]').forEach(btn => {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    const input = this.previousElementSibling;
                    const icon = this.querySelector('.material-symbols-outlined');

                    if (input && icon) {
                        const isPass = input.getAttribute('type') === 'password';
                        input.setAttribute('type', isPass ? 'text' : 'password');
                        icon.textContent = isPass ? 'visibility_off' : 'visibility';
                    }
                });
            });

            // Tự động gỡ ẩn hộp lỗi nếu phát hiện thông báo lỗi
            const valSummary = document.querySelector('[asp-validation-summary]');
            if (valSummary && (valSummary.innerHTML.trim() === "" || valSummary.classList.contains('validation-summary-valid'))) {
                valSummary.classList.add('hidden');
            }
        });
    </script>
}