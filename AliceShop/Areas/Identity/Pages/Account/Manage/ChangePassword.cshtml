@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Đổi mật khẩu | AliceStore";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;

    // Sử dụng layout chung để tự động kế thừa Navbar & Footer động của hệ thống
    Layout = "/Views/Shared/_Layout.cshtml";
}

<main class="flex-grow pt-12 pb-20 px-6 md:px-12 max-w-6xl mx-auto w-full animate-fadeIn">
    <div class="flex flex-col md:flex-row gap-12 items-start">

        <aside class="w-full md:w-60 flex-shrink-0 bg-white border border-outline-variant/20 rounded-xl p-6 shadow-[0_4px_20px_rgba(0,0,0,0.01)]">
            <div class="mb-8">
                <h1 class="font-serif text-2xl text-on-surface mb-1 font-medium tracking-wide">Tài khoản</h1>
                <p class="text-on-surface-variant font-sans text-xs italic font-medium truncate">Chào mừng, @(User.Identity?.Name)</p>
            </div>
            <nav class="flex flex-col space-y-3">
                <a class="flex items-center space-x-3 py-2.5 px-3 rounded-lg transition-all duration-300 text-on-surface-variant hover:text-primary hover:bg-surface-container-low/50 no-underline font-semibold text-sm" asp-page="./Index">
                    <span class="material-symbols-outlined text-xl">person</span>
                    <span class="font-label-md">Thông tin cá nhân</span>
                </a>
                <a class="flex items-center space-x-3 py-2.5 px-3 rounded-lg transition-all duration-300 bg-surface-container-low text-primary no-underline font-semibold text-sm" asp-page="./ChangePassword">
                    <span class="material-symbols-outlined text-xl">security</span>
                    <span class="font-label-md">Đổi mật khẩu</span>
                </a>
                <a class="flex items-center space-x-3 py-2.5 px-3 rounded-lg transition-all duration-300 text-on-surface-variant/40 no-underline font-semibold text-sm cursor-not-allowed" href="#orders">
                    <span class="material-symbols-outlined text-xl">receipt_long</span>
                    <span class="font-label-md">Lịch sử đơn hàng</span>
                </a>

                <div class="pt-4 border-t border-outline-variant/30 mt-2">
                    <form class="form-inline inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                        <button type="submit" class="w-full flex items-center space-x-3 py-2.5 px-3 text-left text-error hover:bg-red-50/50 rounded-lg transition-all bg-transparent border-none cursor-pointer outline-none font-semibold text-sm">
                            <span class="material-symbols-outlined text-xl">logout</span>
                            <span class="font-label-md">Đăng xuất</span>
                        </button>
                    </form>
                </div>
            </nav>
        </aside>

        <div class="flex-grow bg-white border border-outline-variant/20 rounded-xl p-8 md:p-10 shadow-[0_4px_20px_rgba(0,0,0,0.01)]">
            <section class="tab-content">

                <div class="flex justify-between items-end mb-8 border-b border-outline-variant/30 pb-4">
                    <h2 class="font-serif text-xl md:text-2xl font-medium text-on-background uppercase tracking-wide m-0">Đổi mật khẩu</h2>
                    <span class="text-[10px] font-bold text-primary uppercase tracking-widest bg-surface-container-low px-2.5 py-1 rounded-full">Bảo mật nâng cao</span>
                </div>

                <form id="change-password-form" method="post" class="space-y-6 max-w-xl">

                    <div class="animate-fadeIn">
                        <partial name="_StatusMessage" for="StatusMessage" />
                    </div>

                    <div asp-validation-summary="ModelOnly" class="text-xs font-semibold text-error bg-error-container/20 border border-error/20 p-4 rounded-md animate-fadeIn" role="alert"></div>

                    <div class="space-y-1.5 group">
                        <label asp-for="Input.OldPassword" class="block text-[10px] uppercase tracking-[0.15em] text-outline font-bold group-focus-within:text-primary transition-colors">Mật khẩu hiện tại</label>
                        <div class="relative rounded-lg border border-outline-variant group-focus-within:border-primary transition-colors overflow-hidden flex items-center bg-transparent">
                            <input asp-for="Input.OldPassword" class="w-full bg-transparent border-none py-3 px-4 font-sans text-sm font-semibold text-on-background focus:ring-0 outline-none placeholder:text-outline-variant/40" placeholder="Nhập mật khẩu hiện tại" required aria-required="true" />
                            <button class="text-on-surface-variant hover:text-primary transition-colors bg-transparent border-none py-0 px-4 outline-none cursor-pointer flex items-center h-full" type="button">
                                <span class="material-symbols-outlined text-xl">visibility</span>
                            </button>
                        </div>
                        <span asp-validation-for="Input.OldPassword" class="text-xs font-bold text-error mt-1 block"></span>
                    </div>

                    <div class="space-y-1.5 group">
                        <label asp-for="Input.NewPassword" class="block text-[10px] uppercase tracking-[0.15em] text-outline font-bold group-focus-within:text-primary transition-colors">Mật khẩu mới</label>
                        <div class="relative rounded-lg border border-outline-variant group-focus-within:border-primary transition-colors overflow-hidden flex items-center bg-transparent">
                            <input asp-for="Input.NewPassword" class="w-full bg-transparent border-none py-3 px-4 font-sans text-sm font-semibold text-on-background focus:ring-0 outline-none placeholder:text-outline-variant/40" placeholder="Tối thiểu 6 ký tự" required aria-required="true" />
                            <button class="text-on-surface-variant hover:text-primary transition-colors bg-transparent border-none py-0 px-4 outline-none cursor-pointer flex items-center h-full" type="button">
                                <span class="material-symbols-outlined text-xl">visibility</span>
                            </button>
                        </div>
                        <span asp-validation-for="Input.NewPassword" class="text-xs font-bold text-error mt-1 block"></span>
                    </div>

                    <div class="space-y-1.5 group">
                        <label asp-for="Input.ConfirmPassword" class="block text-[10px] uppercase tracking-[0.15em] text-outline font-bold group-focus-within:text-primary transition-colors">Nhập lại mật khẩu mới</label>
                        <div class="relative rounded-lg border border-outline-variant group-focus-within:border-primary transition-colors overflow-hidden flex items-center bg-transparent">
                            <input asp-for="Input.ConfirmPassword" class="w-full bg-transparent border-none py-3 px-4 font-sans text-sm font-semibold text-on-background focus:ring-0 outline-none placeholder:text-outline-variant/40" placeholder="Xác nhận mã khóa mới" required aria-required="true" />
                            <button class="text-on-surface-variant hover:text-primary transition-colors bg-transparent border-none py-0 px-4 outline-none cursor-pointer flex items-center h-full" type="button">
                                <span class="material-symbols-outlined text-xl">visibility</span>
                            </button>
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-xs font-bold text-error mt-1 block"></span>
                    </div>

                    <div class="pt-4 border-t border-outline-variant/20 flex justify-end">
                        <button type="submit" class="w-full sm:w-auto px-10 py-3.5 bg-primary text-on-primary font-label-md text-xs uppercase tracking-widest rounded-lg transition-all duration-300 active:scale-[0.98] hover:bg-opacity-90 cursor-pointer border-none outline-none font-bold shadow-md shadow-primary/10">
                            Cập nhật mật khẩu
                        </button>
                    </div>
                </form>

            </section>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Logic ẩn/hiện mật khẩu bằng eye icon mượt mà cho cả 3 ô nhập liệu
            document.querySelectorAll('button[type="button"]').forEach(btn => {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    const input = this.previousElementSibling;
                    const icon = this.querySelector('.material-symbols-outlined');

                    if (input && icon) {
                        const isPass = input.getAttribute('type') === 'password' || input.getAttribute('type') === null;
                        input.setAttribute('type', isPass ? 'text' : 'password');
                        icon.textContent = isPass ? 'visibility_off' : 'visibility';
                    }
                });
            });

            // Thiết lập trạng thái mật khẩu ẩn mặc định ban đầu cho các ô nhập
            document.querySelectorAll('#change-password-form input').forEach(input => {
                input.setAttribute('type', 'password');
            });

            // Tự động ẩn hộp tóm tắt lỗi nếu trống dữ liệu lỗi
            const valSummary = document.querySelector('[asp-validation-summary]');
            if (valSummary && (valSummary.innerHTML.trim() === "" || valSummary.classList.contains('validation-summary-valid'))) {
                valSummary.classList.add('hidden');
            }
        });
    </script>
}