@page
@model IndexModel
@{
    ViewData["Title"] = "Tài khoản của tôi | AliceStore";
    ViewData["ActivePage"] = ManageNavPages.Index;

    // Sử dụng layout tổng của hệ thống
    Layout = "/Views/Shared/_Layout.cshtml";
}

<!-- CONTAINER BO GỌN GIỮA MÀN HÌNH (Chống tràn ngang máy tính) -->
<main class="flex-grow pt-12 pb-20 px-6 md:px-12 max-w-6xl mx-auto w-full animate-fadeIn">
    <div class="flex flex-col md:flex-row gap-12 items-start">

        <!-- SIDEBAR ĐIỀU HƯỚNG TÀI KHOẢN -->
        <aside class="w-full md:w-60 flex-shrink-0 bg-white border border-outline-variant/20 rounded-xl p-6 shadow-[0_4px_20px_rgba(0,0,0,0.01)]">
            <div class="mb-8">
                <h1 class="font-serif text-2xl text-on-surface mb-1 font-medium tracking-wide">Tài khoản</h1>
                <p class="text-on-surface-variant font-sans text-xs italic font-medium truncate">Chào mừng, @(User.Identity?.Name)</p>
            </div>
            <nav class="flex flex-col space-y-3">
                <a class="flex items-center space-x-3 py-2.5 px-3 rounded-lg transition-all duration-300 bg-surface-container-low text-primary no-underline font-semibold text-sm" asp-page="./Index">
                    <span class="material-symbols-outlined text-xl">person</span>
                    <span class="font-label-md">Thông tin cá nhân</span>
                </a>
                <a class="flex items-center space-x-3 py-2.5 px-3 rounded-lg transition-all duration-300 text-on-surface-variant hover:text-primary hover:bg-surface-container-low/50 no-underline font-semibold text-sm" asp-page="./ChangePassword">
                    <span class="material-symbols-outlined text-xl">security</span>
                    <span class="font-label-md">Đổi mật khẩu</span>
                </a>
                <a class="flex items-center space-x-3 py-2.5 px-3 rounded-lg transition-all duration-300 text-on-surface-variant hover:text-primary hover:bg-surface-container-low/50 no-underline font-semibold text-sm" asp-area="" asp-controller="Profile" asp-action="Orders">
                    <span class="material-symbols-outlined text-xl">receipt_long</span>
                    <span class="font-label-md">Lịch sử đơn hàng</span>
                </a>
                
                <a class="flex items-center space-x-3 py-2.5 px-3 rounded-lg transition-all duration-300 text-on-surface-variant hover:text-primary hover:bg-surface-container-low/50 no-underline font-semibold text-sm" asp-area="" asp-controller="Profile" asp-action="Index">
                    <span class="material-symbols-outlined text-xl">location_on</span>
                    <span class="font-label-md">Sổ địa chỉ</span>
                </a>

                <div class="pt-4 border-t border-outline-variant/30 mt-2">
                    <form class="form-inline inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                        <button type="submit" class="w-full flex items-center space-x-3 py-2.5 px-3 text-left text-error hover:bg-red-50/50 rounded-lg transition-all bg-transparent border-none cursor-pointer outline-none font-semibold text-sm">
                            <span class="material-symbols-outlined text-xl">logout</span>
                            <span class="font-label-md">Đăng xuất</span>
                        </button>
                    </form>
                </div>
            </nav>
        </aside>

        <!-- KHU VỰC NHẬP DỮ LIỆU CHÍNH -->
        <div class="flex-grow bg-white border border-outline-variant/20 rounded-xl p-8 md:p-10 shadow-[0_4px_20px_rgba(0,0,0,0.01)]">
            <section class="tab-content">

                <div class="flex justify-between items-end mb-8 border-b border-outline-variant/30 pb-4">
                    <h2 class="font-serif text-xl md:text-2xl font-medium text-on-background uppercase tracking-wide m-0">Thông tin cá nhân</h2>
                    <span class="text-[10px] font-bold text-primary uppercase tracking-widest bg-surface-container-low px-2.5 py-1 rounded-full">Secure Sync</span>
                </div>

                <form id="profile-form" method="post" enctype="multipart/form-data" class="space-y-8">

                    <!-- Partial thông báo trạng thái -->
                    <div class="animate-fadeIn">
                        <partial name="_StatusMessage" for="StatusMessage" />
                    </div>

                    <div asp-validation-summary="ModelOnly" class="text-xs font-semibold text-error bg-error-container/20 border border-error/20 p-4 rounded-md animate-fadeIn" role="alert"></div>

                    <!-- Khu vực Ảnh đại diện -->
                    <div class="flex items-center gap-6">
                        <div class="relative group w-24 h-24 rounded-full overflow-hidden border-2 border-outline-variant bg-surface-container flex-shrink-0">
                            <img id="avatar-preview" src="@(!string.IsNullOrEmpty(Model.Input.ExistingAvatarUrl) ? Model.Input.ExistingAvatarUrl : "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(Model.Username) + "&background=random")" class="w-full h-full object-cover" alt="Avatar">
                            <label for="Input_AvatarFile" class="absolute inset-0 bg-black/50 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer">
                                <span class="material-symbols-outlined text-2xl">photo_camera</span>
                            </label>
                        </div>
                        <div class="space-y-1">
                            <h3 class="font-bold text-sm text-on-surface">Ảnh đại diện</h3>
                            <p class="text-xs text-on-surface-variant">Khuyến nghị ảnh vuông, tối đa 2MB</p>
                            <input asp-for="Input.AvatarFile" type="file" class="hidden" accept="image/*" onchange="previewAvatar(event)">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-6 gap-x-8">
                        <!-- Email Đăng nhập (Disabled bảo mật) -->
                        <div class="space-y-1.5 group">
                            <label asp-for="Username" class="block text-[10px] uppercase tracking-[0.15em] text-outline font-bold">Email / Tên đăng nhập</label>
                            <input asp-for="Username" class="w-full bg-surface-container-low border border-outline-variant/40 rounded-lg py-3 px-4 font-sans text-sm font-semibold text-on-surface-variant/70 cursor-not-allowed outline-none focus:ring-0" disabled />
                        </div>

                        <!-- Họ và tên -->
                        <div class="space-y-1.5 group">
                            <label asp-for="Input.FullName" class="block text-[10px] uppercase tracking-[0.15em] text-outline font-bold group-focus-within:text-primary transition-colors">Họ và tên</label>
                            <input asp-for="Input.FullName" class="w-full bg-transparent border border-outline-variant focus:border-primary rounded-lg py-3 px-4 font-sans text-sm font-semibold text-on-background focus:ring-0 outline-none transition-colors placeholder:text-outline-variant/40" placeholder="Nhập họ và tên" />
                            <span asp-validation-for="Input.FullName" class="text-xs font-bold text-error mt-1 block"></span>
                        </div>

                        <!-- Số điện thoại -->
                        <div class="space-y-1.5 group">
                            <label asp-for="Input.PhoneNumber" class="block text-[10px] uppercase tracking-[0.15em] text-outline font-bold group-focus-within:text-primary transition-colors">Số điện thoại liên lạc</label>
                            <input asp-for="Input.PhoneNumber" class="w-full bg-transparent border border-outline-variant focus:border-primary rounded-lg py-3 px-4 font-sans text-sm font-semibold text-on-background focus:ring-0 outline-none transition-colors placeholder:text-outline-variant/40" placeholder="Chưa cập nhật số điện thoại" />
                            <span asp-validation-for="Input.PhoneNumber" class="text-xs font-bold text-error mt-1 block"></span>
                        </div>
                    </div>

                    <!-- NÚT LƯU VÀNG KIM NỔI BẬT NỀN TRẮNG -->
                    <div class="pt-4 border-t border-outline-variant/20 flex justify-end">
                        <button id="update-profile-button" type="submit" class="w-full sm:w-auto px-10 py-3.5 bg-primary text-on-primary font-label-md text-xs uppercase tracking-widest rounded-lg transition-all duration-300 active:scale-[0.98] hover:bg-opacity-90 cursor-pointer border-none outline-none font-bold shadow-md shadow-primary/10">
                            Lưu thay đổi thông tin
                        </button>
                    </div>
                </form>

            </section>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const valSummary = document.querySelector('[asp-validation-summary]');
            if (valSummary && (valSummary.innerHTML.trim() === "" || valSummary.classList.contains('validation-summary-valid'))) {
                valSummary.classList.add('hidden');
            }
        });

        function previewAvatar(event) {
            const input = event.target;
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('avatar-preview').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}