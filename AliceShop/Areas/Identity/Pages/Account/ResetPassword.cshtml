@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu mới | AliceStore";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<main class="flex-grow flex items-center justify-center pt-16 pb-24 px-6 bg-background animate-fadeIn">
    <div class="w-full max-w-md bg-white border border-outline-variant/30 rounded-xl p-8 md:p-10 shadow-[0_4px_25px_rgba(0,0,0,0.01)] text-center">

        <header class="mb-8">
            <h1 class="font-sans text-xl md:text-2xl font-bold text-on-background uppercase tracking-wide m-0">Thiết lập mã khóa</h1>
            <p class="text-on-surface-variant/80 font-sans text-xs mt-2 leading-relaxed">
                Nhập mật mã bảo mật mới cho tài khoản của bạn bên dưới để hoàn tất quy trình đồng bộ hóa dữ liệu.
            </p>
        </header>

        <form method="post" class="space-y-5 text-left">
            <div asp-validation-summary="All" class="text-xs font-semibold text-error bg-error-container/20 border border-error/20 p-4 rounded-md animate-fadeIn" role="alert"></div>

            <input asp-for="Input.Code" type="hidden" />
            <input asp-for="Input.Email" type="hidden" />

            <div class="space-y-1.5 group">
                <label asp-for="Input.Password" class="block text-[10px] uppercase tracking-[0.15em] text-outline font-bold group-focus-within:text-primary transition-colors">Mật khẩu mới</label>
                <div class="relative rounded-lg border border-outline-variant group-focus-within:border-primary transition-colors overflow-hidden flex items-center bg-transparent">
                    <input asp-for="Input.Password" type="password" class="w-full bg-transparent border-none py-3 px-4 font-sans text-sm font-semibold text-on-background focus:ring-0 outline-none placeholder:text-outline-variant/40" placeholder="Tối thiểu 6 ký tự" required />
                    <button class="text-on-surface-variant hover:text-primary transition-colors bg-transparent border-none py-0 px-4 outline-none cursor-pointer flex items-center h-full" type="button">
                        <span class="material-symbols-outlined text-xl">visibility</span>
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="text-xs font-bold text-error mt-1 block"></span>
            </div>

            <div class="space-y-1.5 group">
                <label asp-for="Input.ConfirmPassword" class="block text-[10px] uppercase tracking-[0.15em] text-outline font-bold group-focus-within:text-primary transition-colors">Nhập lại mật khẩu mới</label>
                <div class="relative rounded-lg border border-outline-variant group-focus-within:border-primary transition-colors overflow-hidden flex items-center bg-transparent">
                    <input asp-for="Input.ConfirmPassword" type="password" class="w-full bg-transparent border-none py-3 px-4 font-sans text-sm font-semibold text-on-background focus:ring-0 outline-none placeholder:text-outline-variant/40" placeholder="Xác nhận mã khóa mới" required />
                    <button class="text-on-surface-variant hover:text-primary transition-colors bg-transparent border-none py-0 px-4 outline-none cursor-pointer flex items-center h-full" type="button">
                        <span class="material-symbols-outlined text-xl">visibility</span>
                    </button>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-xs font-bold text-error mt-1 block"></span>
            </div>

            <button type="submit" class="w-full py-3.5 bg-primary text-on-primary font-label-md text-xs uppercase tracking-widest rounded-lg transition-all duration-300 active:scale-[0.98] hover:bg-opacity-90 cursor-pointer border-none outline-none font-bold shadow-md shadow-primary/10">
                Lưu mật khẩu mới
            </button>
        </form>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Logic ẩn/hiện mật khẩu bằng mắt icon mượt mà
            document.querySelectorAll('button[type="button"]').forEach(btn => {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    const input = this.previousElementSibling;
                    const icon = this.querySelector('.material-symbols-outlined');

                    if (input && icon) {
                        const isPass = input.getAttribute('type') === 'password';
                        input.setAttribute('type', isPass ? 'text' : 'password');
                        icon.textContent = isPass ? 'visibility_off' : 'visibility';
                    }
                });
            });

            // Sửa lại validation summary: Nếu có lỗi thật từ Server gửi về (như sai token, trùng pass cũ...) thì hiển thị lên rõ ràng
            const valSummary = document.querySelector('[asp-validation-summary]');
            if (valSummary) {
                const hasErrors = valSummary.querySelectorAll('ul li').length > 0;
                if (!hasErrors || valSummary.classList.contains('validation-summary-valid')) {
                    valSummary.classList.add('hidden');
                } else {
                    valSummary.classList.remove('hidden');
                }
            }
        });
    </script>
}