@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Khôi phục mật khẩu | AliceStore";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<main class="flex-grow flex items-center justify-center pt-16 pb-24 px-6 bg-background animate-fadeIn">
    <div class="w-full max-w-md bg-white border border-outline-variant/30 rounded-xl p-8 md:p-10 shadow-[0_4px_25px_rgba(0,0,0,0.01)] text-center">

        <!-- TIÊU ĐỀ NÉT CHỮ HÌNH KHỐI ĐỀU NHAU (SỬA LỖI PHÔNG CHỮ TIẾNG VIỆT) -->
        <header class="mb-8">
            <h1 class="font-sans text-xl md:text-2xl font-bold text-on-background uppercase tracking-wide m-0">Quên mật khẩu?</h1>
            <p class="text-on-surface-variant/80 font-sans text-xs mt-2 leading-relaxed">
                Nhập địa chỉ email tài khoản của bạn. Chúng tôi sẽ gửi một liên kết bảo mật để thiết lập lại mật mã mới ngay lập tức.
            </p>
        </header>

        <form method="post" class="space-y-6 text-left">
            <!-- Khối hiển thị lỗi tổng quan -->
            <div asp-validation-summary="All" class="text-xs font-semibold text-error bg-error-container/20 border border-error/20 p-4 rounded-md animate-fadeIn" role="alert"></div>

            <!-- Ô nhập liệu Email -->
            <div class="space-y-1.5 group">
                <label asp-for="Input.Email" class="block text-[10px] uppercase tracking-[0.15em] text-outline font-bold group-focus-within:text-primary transition-colors">Địa chỉ hộp thư Email</label>
                <div class="relative rounded-lg border border-outline-variant group-focus-within:border-primary transition-colors overflow-hidden flex items-center bg-transparent">
                    <input asp-for="Input.Email" class="w-full bg-transparent border-none py-3 px-4 font-sans text-sm font-semibold text-on-background focus:ring-0 outline-none placeholder:text-outline-variant/50"
                           placeholder="example@alice.store" required aria-required="true" />
                </div>
                <span asp-validation-for="Input.Email" class="text-xs font-bold text-error mt-1 block"></span>
            </div>

            <!-- Nút bấm gửi yêu cầu Vàng Kim tăng tối đa độ tương phản -->
            <button type="submit" class="w-full py-3.5 bg-primary text-on-primary font-label-md text-xs uppercase tracking-widest rounded-lg transition-all duration-300 active:scale-[0.98] hover:bg-opacity-90 cursor-pointer border-none outline-none font-bold shadow-md shadow-primary/10">
                Gửi liên kết khôi phục
            </button>
        </form>

        <div class="mt-6 pt-4 border-t border-outline-variant/30 text-center">
            <a asp-page="./Login" class="text-xs font-bold text-on-surface-variant hover:text-primary no-underline transition-colors flex items-center justify-center gap-1">
                <span class="material-symbols-outlined text-sm">arrow_back</span> Quay lại trang đăng nhập
            </a>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const valSummary = document.querySelector('[asp-validation-summary]');
            if (valSummary && (valSummary.innerHTML.trim() === "" || valSummary.classList.contains('validation-summary-valid'))) {
                valSummary.classList.add('hidden');
            }
        });
    </script>
}