@model AliceShop.Models.UserAddress

@{
    ViewData["Title"] = "Thêm Địa Chỉ Mới | AliceStore";
}

<main class="flex-grow pt-12 pb-20 px-6 md:px-12 max-w-6xl mx-auto w-full animate-fadeIn font-sans">
    <div class="flex flex-col md:flex-row gap-12 items-start">

        <aside class="w-full md:w-60 flex-shrink-0 bg-white border border-outline-variant/20 rounded-xl p-6 shadow-[0_4px_20px_rgba(0,0,0,0.01)]">
            <div class="mb-8">
                <h1 class="font-serif text-2xl text-on-surface mb-1 font-medium tracking-wide">Tài khoản</h1>
                <p class="text-on-surface-variant font-sans text-xs italic font-medium truncate">Chào mừng, @(User.Identity?.Name)</p>
            </div>
            <nav class="flex flex-col space-y-3">
                <a class="flex items-center space-x-3 py-2.5 px-3 rounded-lg transition-all duration-300 text-on-surface-variant hover:text-primary hover:bg-surface-container-low/50 no-underline font-semibold text-sm" asp-area="Identity" asp-page="/Account/Manage/Index">
                    <span class="material-symbols-outlined text-xl">person</span>
                    <span class="font-sans">Thông tin cá nhân</span>
                </a>
                <a class="flex items-center space-x-3 py-2.5 px-3 rounded-lg transition-all duration-300 text-on-surface-variant hover:text-primary hover:bg-surface-container-low/50 no-underline font-semibold text-sm" asp-area="Identity" asp-page="/Account/Manage/ChangePassword">
                    <span class="material-symbols-outlined text-xl">security</span>
                    <span class="font-sans">Đổi mật khẩu</span>
                </a>

                <a class="flex items-center space-x-3 py-2.5 px-3 rounded-lg transition-all duration-300 text-on-surface-variant hover:text-primary hover:bg-surface-container-low/50 no-underline font-semibold text-sm" asp-area="" asp-controller="Profile" asp-action="Orders">
                    <span class="material-symbols-outlined text-xl">receipt_long</span>
                    <span class="font-sans">Lịch sử đơn hàng</span>
                </a>

                <a class="flex items-center space-x-3 py-2.5 px-3 rounded-lg transition-all duration-300 bg-surface-container-low text-primary no-underline font-semibold text-sm" asp-area="" asp-controller="Profile" asp-action="Index">
                    <span class="material-symbols-outlined text-xl" style="font-variation-settings: 'FILL' 1;">location_on</span>
                    <span class="font-sans">Sổ địa chỉ</span>
                </a>

                <div class="pt-4 border-t border-outline-variant/30 mt-2">
                    <form class="form-inline inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                        <button type="submit" class="w-full flex items-center space-x-3 py-2.5 px-3 text-left text-error hover:bg-red-50/50 rounded-lg transition-all bg-transparent border-none cursor-pointer outline-none font-semibold text-sm">
                            <span class="material-symbols-outlined text-xl">logout</span>
                            <span class="font-sans">Đăng xuất</span>
                        </button>
                    </form>
                </div>
            </nav>
        </aside>

        <div class="flex-grow bg-white border border-outline-variant/20 rounded-xl p-8 md:p-10 shadow-[0_4px_20px_rgba(0,0,0,0.01)] min-h-[500px]">
            <header class="mb-12">
                <h1 class="font-serif text-[32px] md:text-[40px] leading-tight font-medium text-on-surface mb-3 m-0">Thêm Địa Chỉ Mới</h1>
                <p class="font-sans text-sm md:text-base text-[#5f5e5e] max-w-xl m-0">Vui lòng điền thông tin chi tiết bên dưới để hoàn tất quá trình thiết lập địa chỉ giao hàng bưu kiện trang sức.</p>
            </header>

            <form asp-controller="Profile" asp-action="CreateAddress" method="post" class="space-y-10 m-0">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-xs text-red-600 font-semibold bg-red-50 p-4 border border-red-200 rounded"></div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="flex flex-col gap-2">
                        <label class="font-sans text-xs font-bold text-[#5f5e5e] uppercase tracking-widest">Họ và tên người nhận <span class="text-red-600">*</span></label>
                        <input asp-for="FullName" class="bg-transparent border-0 border-b border-[#d1c5b4] py-2 px-0 font-sans text-base font-semibold text-on-surface transition-all duration-300 placeholder:text-[#d1c5b4]/50 focus:ring-0 focus:border-primary focus:outline-none" placeholder="Nguyễn Văn A" type="text" required />
                        <span asp-validation-for="FullName" class="text-xs text-red-600 font-medium mt-1"></span>
                    </div>
                    <div class="flex flex-col gap-2">
                        <label class="font-sans text-xs font-bold text-[#5f5e5e] uppercase tracking-widest">Số điện thoại liên hệ <span class="text-red-600">*</span></label>
                        <input asp-for="PhoneNumber" class="bg-transparent border-0 border-b border-[#d1c5b4] py-2 px-0 font-sans text-base font-semibold text-on-surface transition-all duration-300 placeholder:text-[#d1c5b4]/50 focus:ring-0 focus:border-primary focus:outline-none" placeholder="0901234567" type="tel" required />
                        <span asp-validation-for="PhoneNumber" class="text-xs text-red-600 font-medium mt-1"></span>
                    </div>
                </div>

                <div class="flex flex-col gap-2">
                    <label class="font-sans text-xs font-bold text-[#5f5e5e] uppercase tracking-widest">Địa chỉ giao hàng cụ thể <span class="text-red-600">*</span></label>
                    <textarea asp-for="DetailedAddress" class="bg-transparent border-0 border-b border-[#d1c5b4] py-2 px-0 font-sans text-base font-semibold text-on-surface transition-all duration-300 placeholder:text-[#d1c5b4]/50 focus:ring-0 focus:border-primary focus:outline-none resize-none leading-relaxed" placeholder="Số nhà, tên đường, Phường/Xã, Quận/Huyện, Tỉnh/Thành phố..." rows="3" required></textarea>
                    <span asp-validation-for="DetailedAddress" class="text-xs text-red-600 font-medium mt-1"></span>
                </div>

                <div class="flex items-center gap-3 py-2">
                    <input asp-for="IsDefault" class="w-4 h-4 border-[#7f7667] rounded text-primary focus:ring-primary focus:ring-offset-[#faf9f7] bg-transparent cursor-pointer" id="default-address" type="checkbox" />
                    <label class="font-sans text-sm text-on-surface font-medium cursor-pointer select-none" for="default-address">Đặt làm địa chỉ mặc định khi thanh toán túi hàng</label>
                </div>

                <div class="flex flex-col sm:flex-row items-center gap-4 pt-4">
                    <button class="w-full sm:w-auto bg-[#2f3130] text-[#faf9f7] py-3 px-10 font-sans text-xs font-bold uppercase tracking-widest rounded-sm hover:bg-[#1a1c1b] border-none cursor-pointer outline-none active:scale-[0.98] transition-all" type="submit">
                        Lưu địa chỉ
                    </button>
                    <a asp-action="Index" class="w-full sm:w-auto bg-transparent border border-[#7f7667] text-on-surface py-3 px-10 font-sans text-xs font-bold uppercase tracking-widest rounded-sm hover:bg-[#e3e2e0]/20 no-underline text-center active:scale-[0.98] transition-all">
                        Hủy bỏ
                    </a>
                </div>
            </form>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
