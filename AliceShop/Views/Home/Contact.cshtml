@{
    ViewData["Title"] = "Liên Hệ | AliceShop Luxury Jewellery";
}

<main class="pt-12 pb-20 max-w-[1440px] mx-auto px-6 md:px-20 animate-fadeIn">

    <header class="text-center max-w-2xl mx-auto mb-16 space-y-3">
        <span class="text-xs font-bold text-primary uppercase tracking-[0.3em] block">Kết nối cùng chúng tôi</span>
        <h1 class="font-serif text-3xl md:text-5xl font-medium text-on-background uppercase tracking-wide m-0">Liên Hệ</h1>
        <p class="text-on-surface-variant font-sans text-sm font-medium leading-relaxed">
            AliceShop luôn sẵn sàng lắng nghe mọi tâm tư, yêu cầu đặt chế tác riêng hoặc phản hồi dịch vụ từ quý khách.
        </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">

        <div class="lg:col-span-5 space-y-10">
            <div class="bg-surface-container-low p-8 rounded-lg border border-outline-variant/30 shadow-sm space-y-8">
                <div>
                    <h3 class="font-serif text-lg font-medium text-on-background uppercase tracking-wider mb-4">Đại Lộ Alice Store</h3>

                    <div class="flex items-start gap-4 py-3 border-b border-outline-variant/20">
                        <span class="material-symbols-outlined text-primary mt-0.5">location_on</span>
                        <div>
                            <h4 class="text-xs font-bold uppercase tracking-widest text-on-surface m-0 mb-1">Không gian trưng bày</h4>
                            <p class="text-sm text-on-surface-variant font-medium m-0 leading-relaxed">
                                Khu Công nghệ cao, Võ Văn Ngân, Phường Long Thạnh Mỹ, TP. Thủ Đức, TP. Hồ Chí Minh
                            </p>
                        </div>
                    </div>

                    <div class="flex items-start gap-4 py-3 border-b border-outline-variant/20">
                        <span class="material-symbols-outlined text-primary mt-0.5">call</span>
                        <div>
                            <h4 class="text-xs font-bold uppercase tracking-widest text-on-surface m-0 mb-1">Hotline thượng khách</h4>
                            <p class="text-sm font-sans text-primary font-bold m-0 tracking-wide">
                                1900 6868 — (028) 5555 9999
                            </p>
                        </div>
                    </div>

                    <div class="flex items-start gap-4 py-3 border-b border-outline-variant/20">
                        <span class="material-symbols-outlined text-primary mt-0.5">mail</span>
                        <div>
                            <h4 class="text-xs font-bold uppercase tracking-widest text-on-surface m-0 mb-1">Thư điện tử chính thức</h4>
                            <p class="text-sm font-sans text-on-surface-variant font-semibold m-0">
                                contact@@aliceshop.id.vn
                            </p>
                        </div>
                    </div>

                    <div class="flex items-start gap-4 py-3">
                        <span class="material-symbols-outlined text-primary mt-0.5">schedule</span>
                        <div>
                            <h4 class="text-xs font-bold uppercase tracking-widest text-on-surface m-0 mb-1">Thời gian đón tiếp</h4>
                            <p class="text-sm text-on-surface-variant font-medium m-0">
                                Thứ Hai — Chủ Nhật: 09:00 AM – 09:00 PM
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="w-full aspect-[4/3] rounded-lg overflow-hidden border border-outline-variant/30 shadow-sm">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3918.479532857418!2d106.78453447571343!3d10.851084257813476!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3175276eafcd51b1%3A0x9ab8d6f519c5c7!2zVHLGsOG7nW5nIMSQ4bqhaSBo4buNYyBDw7RuZyBuZ2jhu4cgVFAuSENNIChIVVRFQ0gpIC0gQ8ahIHPhu58gVGjhu6cgxJDhu6lj!5e0!3m2!1svi!2s!4v1710000000000!5m2!1svi!2s"
                        class="w-full h-full border-0 grayscale opacity-80 hover:grayscale-0 hover:opacity-100 transition-all duration-500"
                        allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
                </iframe>
            </div>
        </div>

        <div class="lg:col-span-7 bg-surface-container-low p-8 md:p-10 rounded-lg border border-outline-variant/30 shadow-sm">
            <h3 class="font-serif text-xl font-medium text-on-background uppercase tracking-wider mb-2">Để lại lời nhắn</h3>
            <p class="text-xs text-on-surface-variant font-medium mb-8">Hệ thống cố vấn kim hoàn sẽ phản hồi tâm thư của bạn trong vòng 24 giờ làm việc.</p>

            <form action="#" method="post" class="space-y-8" onsubmit="handleContactSubmit(event)">

                <div class="space-y-2">
                    <label class="font-bold text-xs uppercase tracking-widest text-on-surface block mb-1">Họ và tên của quý khách <span class="text-red-600">*</span></label>
                    <input type="text" id="contact-name" class="w-full input-underline py-3 px-0 text-sm font-medium text-on-background bg-transparent focus:ring-0 focus:outline-none" placeholder="Ví dụ: Trần Thị Ngà" required />
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="space-y-2">
                        <label class="font-bold text-xs uppercase tracking-widest text-on-surface block mb-1">Địa chỉ Email <span class="text-red-600">*</span></label>
                        <input type="email" id="contact-email" class="w-full input-underline py-3 px-0 text-sm font-medium text-on-background bg-transparent focus:ring-0 focus:outline-none" placeholder="example@@gmail.com" required />
                    </div>

                    <div class="space-y-2">
                        <label class="font-bold text-xs uppercase tracking-widest text-on-surface block mb-1">Số điện thoại liên lạc <span class="text-red-600">*</span></label>
                        <input type="tel" id="contact-phone" class="w-full input-underline py-3 px-0 text-sm font-medium text-on-background bg-transparent focus:ring-0 focus:outline-none" placeholder="0901 234 567" required />
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="font-bold text-xs uppercase tracking-widest text-on-surface block mb-1">Chủ đề liên hệ <span class="text-red-600">*</span></label>
                    <input type="text" id="contact-subject" class="w-full input-underline py-3 px-0 text-sm font-medium text-on-background bg-transparent focus:ring-0 focus:outline-none" placeholder="Ví dụ: Đặt lịch tư vấn nhẫn cưới kim cương độc bản / Hợp tác" required />
                </div>

                <div class="space-y-2">
                    <label class="font-bold text-xs uppercase tracking-widest text-on-surface block mb-1">Nội dung chi tiết lời nhắn</label>
                    <textarea id="contact-message" class="w-full input-underline py-3 px-0 text-sm text-on-background font-medium text-justify resize-none bg-transparent focus:ring-0 focus:outline-none" rows="5" placeholder="Quý khách có thể chia sẻ cụ thể hơn về nhu cầu của mình tại đây..."></textarea>
                </div>

                <div class="pt-4">
                    <button type="submit" class="w-full sm:w-auto px-12 py-4 bg-on-background text-white font-semibold text-xs uppercase tracking-widest rounded-md hover:bg-primary transition-colors shadow-sm cursor-pointer outline-none border border-transparent">
                        Gửi Lời Nhắn Đến Alice Store
                    </button>
                </div>
            </form>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        // Hàm giả lập bắt sự kiện gửi form bằng JavaScript mượt mà thông báo Quiet Luxury
        function handleContactSubmit(event) {
            event.preventDefault();

            const name = document.getElementById('contact-name').value;

            // Hiện hộp thông báo sang trọng của trình duyệt
            alert(`Cảm ơn quý khách ${name}, Alice Store đã tiếp nhận tâm thư liên hệ thành công. Đội ngũ cố vấn kim hoàn sẽ kết nối đến bạn trong thời gian sớm nhất!`);

            // Reset lại form trống
            event.target.reset();
        }
    </script>
}