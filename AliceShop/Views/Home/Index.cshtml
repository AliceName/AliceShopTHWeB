@{
    ViewData["Title"] = "Trang Chủ | Hệ Thống Trang Sức Cao Cấp";
}

<div class="position-relative overflow-hidden p-5 text-center bg-dark text-light border-bottom border-warning border-opacity-10 shadow-sm rounded-4 mb-5"
     style="background: linear-gradient(rgba(0, 0, 0, 0.75), rgba(0, 0, 0, 0.85)), url('https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?q=80&w=1200') no-repeat center/cover; min-height: 400px; display: flex; align-items: center;">
    <div class="col-md-8 p-lg-5 mx-auto my-3">
        <span class="text-warning text-uppercase tracking-widest small fw-bold mb-2 d-block">
            <i class="bi bi-gem me-2"></i>Chế tác tinh xảo - Tỏa sáng quý phái
        </span>
        <h1 class="display-4 fw-bold text-white mb-3 font-monospace tracking-wide">ALICE SHOP</h1>
        <p class="lead fw-normal text-secondary mx-auto mb-4" style="max-width: 600px; font-size: 1.1rem;">
            Khám phá bộ sưu tập trang sức, phụ kiện đá quý chế tác độc quyền. Đồng hành cùng vẻ đẹp tự tin, khí chất kiêu sa của phụ nữ Việt.
        </p>
        <a class="btn btn-warning btn-lg px-4 py-2.5 text-dark fw-bold shadow transition-all rounded-pill hover-scale" asp-controller="Product" asp-action="Collection">
            Khám phá bộ sưu tập <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
</div>

<div class="container">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-dark position-relative d-inline-block pb-2 mb-2">
            Danh Mục Nổi Bật
        </h2>
        <p class="text-muted small">Tìm kiếm nhanh theo từng nhóm phụ kiện tinh tế</p>
    </div>

    <div class="row g-4 justify-content-center mb-5">
        <div class="col-6 col-md-3">
            <div class="card h-100 border-0 shadow-sm text-center bg-white rounded-3 overflow-hidden p-3 hover-shadow transition-all">
                <div class="d-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning rounded-circle mx-auto mb-3" style="width: 70px; height: 70px;">
                    <i class="bi bi-heart-fill fs-3"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">Nhẫn Quý Phái</h5>
                <a asp-controller="Product" asp-action="Index" class="small text-warning text-decoration-none fw-semibold">Xem ngay →</a>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card h-100 border-0 shadow-sm text-center bg-white rounded-3 overflow-hidden p-3 hover-shadow transition-all">
                <div class="d-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning rounded-circle mx-auto mb-3" style="width: 70px; height: 70px;">
                    <i class="bi bi-gem fs-3"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">Dây Chuyền</h5>
                <a asp-controller="Product" asp-action="Index" class="small text-warning text-decoration-none fw-semibold">Xem ngay →</a>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card h-100 border-0 shadow-sm text-center bg-white rounded-3 overflow-hidden p-3 hover-shadow transition-all">
                <div class="d-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning rounded-circle mx-auto mb-3" style="width: 70px; height: 70px;">
                    <i class="bi bi-activity fs-3"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">Vòng & Lắc Tay</h5>
                <a asp-controller="Product" asp-action="Index" class="small text-warning text-decoration-none fw-semibold">Xem ngay →</a>
            </div>
        </div>
    </div>

    <hr class="opacity-10 my-5" />

    <div class="row g-4 py-3 text-center">
        <div class="col-md-4">
            <div class="p-3">
                <i class="bi bi-shield-check text-warning fs-1 mb-2 d-block"></i>
                <h5 class="fw-bold text-dark">Cam Kết Chính Hãng</h5>
                <p class="text-secondary small px-lg-4">Mọi sản phẩm bán ra đều đạt chứng nhận tuổi vàng chuẩn quốc tế, minh bạch hóa đơn.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3">
                <i class="bi bi-stars text-warning fs-1 mb-2 d-block"></i>
                <h5 class="fw-bold text-dark">Chế Tác Độc Quyền</h5>
                <p class="text-secondary small px-lg-4">Mẫu mã đi đầu xu hướng thời trang, được mài giũa thủ công tỉ mỉ bởi nghệ nhân lành nghề.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3">
                <i class="bi bi-arrow-counterclockwise text-warning fs-1 mb-2 d-block"></i>
                <h5 class="fw-bold text-dark">Bảo Hành Trọn Đời</h5>
                <p class="text-secondary small px-lg-4">Miễn phí dịch vụ siêu âm làm sạch, đánh bóng và tân trang định kỳ trọn đời sản phẩm.</p>
            </div>
        </div>
    </div>
</div>

<style>
    .tracking-widest {
        letter-spacing: 3px;
    }

    .tracking-wide {
        letter-spacing: 1px;
    }

    .transition-all {
        transition: all 0.3s ease-in-out;
    }

    /* Hiệu ứng phóng to nhẹ khi di chuột vào nút */
    .hover-scale:hover {
        transform: scale(1.03);
        box-shadow: 0 4px 15px rgba(255, 193, 7, 0.4) !important;
    }

    /* Hiệu ứng bóng đổ và nâng nhẹ card danh mục khi đưa chuột qua */
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08) !important;
    }
</style>