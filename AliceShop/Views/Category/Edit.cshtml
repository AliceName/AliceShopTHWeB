@model AliceShop.Models.Category

@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Index" class="text-secondary text-decoration-none small hover-text-warning">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white mx-auto" style="max-width: 600px;">
        <div class="card-header bg-dark text-light py-3 px-4 border-bottom border-warning border-opacity-25">
            <h5 class="mb-0 fw-bold tracking-widest text-warning text-uppercase">
                <i class="bi bi-pencil-square me-2"></i>Thay đổi tên danh mục
            </h5>
        </div>

        <div class="card-body p-4 p-md-5">
            <form asp-action="Edit">
                <input type="hidden" asp-for="Id" />

                <div class="form-group mb-4">
                    <label asp-for="Name" class="form-label fw-bold text-secondary small text-uppercase">Tên danh mục mới <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control form-control-lg border-2" required />
                    <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="pt-3 border-top d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy bỏ</a>
                    <button type="submit" class="btn btn-warning px-4 text-dark fw-bold shadow-sm">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .tracking-widest {
        letter-spacing: 1px;
    }

    .form-control:focus {
        border-color: #ffc107 !important;
        box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.15) !important;
    }

    .hover-text-warning:hover {
        color: #ffc107 !important;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}