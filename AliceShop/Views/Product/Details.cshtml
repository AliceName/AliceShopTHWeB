@model AliceShop.Models.Product

@{
    ViewData["Title"] = Model?.Name ?? "Chi tiết sản phẩm";

    // Logic đường dẫn ảnh đại diện chính an toàn chống gãy thẻ img
    var mainImgUrl = string.IsNullOrEmpty(Model?.ImageUrl) ? "/images/placeholder.png" : Model.ImageUrl;

    // Sắp xếp danh sách size từ nhỏ đến lớn để hiển thị ngăn nắp
    var activeVariants = Model?.ProductSizeVariants?.OrderBy(v => v.ProductSize.SizeName).ToList() ?? new List<AliceShop.Models.ProductSizeVariant>();

    // 🔥 Tự động nhận diện nhãn hiển thị thông minh theo tên danh mục sản phẩm giống trang Admin
    string sizeLabel = "Kích cỡ / Size";
    if (Model?.Category != null)
    {
        string cateName = Model.Category.Name.ToLower();
        if (cateName.Contains("nhẫn") || cateName.Contains("nhan"))
        {
            sizeLabel = "Chọn kích cỡ nhẫn (Size)";
        }
        else if (cateName.Contains("dây") || cateName.Contains("chuỗi") || cateName.Contains("day chuyen"))
        {
            sizeLabel = "Chọn chiều dài chuỗi dây";
        }
        else if (cateName.Contains("lắc") || cateName.Contains("vòng") || cateName.Contains("lac") || cateName.Contains("vong"))
        {
            sizeLabel = "Chọn kích cỡ vòng / lắc tay";
        }
    }
}

<main class="animate-fadeIn max-w-[1440px] mx-auto px-6 md:px-20">
    <section class="py-8">
        <nav class="flex items-center gap-2 font-semibold text-xs text-secondary uppercase tracking-widest">
            <a class="hover:text-primary no-underline transition-colors" asp-controller="Home" asp-action="Index">Trang chủ</a>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <a class="hover:text-primary no-underline transition-colors" asp-controller="Product" asp-action="Collection">Sản phẩm</a>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <span class="text-on-surface">@Model?.Name</span>
        </nav>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-12 gap-16 pb-20">
        <div class="md:col-span-7 flex flex-col gap-6">
            <div class="aspect-[4/5] overflow-hidden bg-surface-container-low group rounded-lg border border-outline-variant/10 shadow-sm relative">
                <img src="@mainImgUrl" alt="@Model?.Name" id="focused-main-img" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
            </div>

            <div class="grid grid-cols-4 gap-6">
                <div class="aspect-square bg-surface-container-low overflow-hidden cursor-pointer border border-primary rounded-md shadow-sm thumb-div transition-all duration-300 opacity-100" onclick="switchDetailImage('@mainImgUrl', this)">
                    <img src="@mainImgUrl" class="w-full h-full object-cover" alt="Main Thumb" />
                </div>

                @if (Model?.Images != null && Model.Images.Any())
                {
                    foreach (var img in Model.Images)
                    {
                        if (!string.Equals(img.Url, Model.ImageUrl, StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="aspect-square bg-surface-container-low overflow-hidden cursor-pointer opacity-60 hover:opacity-100 border border-transparent rounded-md shadow-sm thumb-div transition-all duration-300" onclick="switchDetailImage('@img.Url', this)">
                                <img src="@img.Url" class="w-full h-full object-cover" alt="Gallery Thumb" />
                            </div>
                        }
                    }
                }
            </div>
        </div>

        <div class="md:col-span-5 flex flex-col gap-10 py-2 justify-start">
            <div class="flex flex-col gap-4">
                <p class="font-semibold text-xs text-primary uppercase tracking-[0.2em] m-0">Sản phẩm tiêu biểu</p>
                <h1 class="font-serif text-2xl md:text-3xl font-medium text-on-surface uppercase tracking-wide leading-tight m-0">@Model?.Name</h1>
                <p class="font-sans text-xl font-bold text-primary m-0" id="product-price-display">
                    @string.Format("{0:N0} ₫", Model?.Price)
                </p>
            </div>

            <div class="flex flex-col gap-4 border-t border-outline-variant/30 pt-6">
                <p class="text-on-surface-variant text-sm leading-relaxed m-0 text-justify">
                    @Model?.Description
                </p>

                <div class="flex flex-wrap gap-2 pt-1">
                    <span class="px-3 py-1 bg-surface-container-highest text-secondary text-[12px] font-semibold rounded-full uppercase tracking-tighter border border-outline-variant/30">
                        @(Model?.Category?.Name ?? "Trang sức")
                    </span>
                    <span class="px-3 py-1 bg-surface-container-highest text-secondary text-[12px] font-semibold rounded-full uppercase tracking-tighter border border-outline-variant/30">
                        @(Model?.Material?.Name ?? "Cao cấp")
                    </span>
                </div>
            </div>

            <form id="add-to-cart-form" asp-controller="ShoppingCart" asp-action="AddToCart" method="post" class="m-0 p-0 flex flex-col gap-6">
                <input type="hidden" name="productId" value="@Model?.Id" />
                <input type="hidden" name="quantity" id="quantity-actual" value="1" />

                <div>
                    <p class="font-semibold text-xs text-on-surface uppercase tracking-widest mb-3">@sizeLabel</p>
                    <div class="flex flex-wrap gap-3" id="size-selector-container">
                        @if (activeVariants.Any())
                        {
                            for (int i = 0; i < activeVariants.Count; i++)
                            {
                                var v = activeVariants[i];
                                <label class="cursor-pointer select-none">
                                    <input type="radio" name="sizeVariantId" value="@v.Id" class="sr-only peer" @(i == 0 ? "checked" : "")
                                           data-price="@v.Price" data-formatted-price="@string.Format("{0:N0} ₫", v.Price)" />

                                    <div class="px-5 py-2.5 border border-outline text-on-surface text-xs font-bold rounded-lg hover:border-primary transition-all bg-white peer-checked:bg-primary peer-checked:text-white peer-checked:border-primary flex items-center justify-center min-w-[75px]">
                                        @v.ProductSize.SizeName
                                    </div>
                                </label>
                            }
                        }
                        else
                        {
                            <p class="text-xs text-amber-700 italic font-medium m-0">Tác phẩm này hiện tại đang tạm hết hàng ở mọi kích cỡ.</p>
                        }
                    </div>
                </div>

                <div>
                    <p class="font-semibold text-xs text-on-surface uppercase tracking-widest mb-3">Số lượng</p>
                    <div class="flex items-center border border-outline-variant w-fit rounded-lg bg-white overflow-hidden shadow-sm">
                        <button type="button" class="px-4 py-2 hover:bg-surface-container transition-colors flex items-center justify-center outline-none border-none bg-transparent cursor-pointer" onclick="modifyProductQty(-1)">
                            <span class="material-symbols-outlined text-[18px] font-bold">remove</span>
                        </button>
                        <span id="display-quantity" class="px-5 py-2 font-sans text-xs font-bold select-none min-w-[25px] text-center">1</span>
                        <button type="button" class="px-4 py-2 hover:bg-surface-container transition-colors flex items-center justify-center outline-none border-none bg-transparent cursor-pointer" onclick="modifyProductQty(1)">
                            <span class="material-symbols-outlined text-[18px] font-bold">add</span>
                        </button>
                    </div>
                </div>

                @if (activeVariants.Any())
                {
                    <div class="flex flex-col gap-4 pt-2 w-full">
                        <button type="button" id="btn-add-cart" onclick="submitAddToCartAjax()" class="relative w-full h-12 text-white font-semibold text-xs uppercase tracking-widest rounded-md hover:bg-opacity-90 transition-all duration-300 flex items-center justify-center shadow-md cursor-pointer outline-none border border-transparent overflow-hidden" style="background-color: #1a1c1b;">
                            <span id="btn-add-text">Thêm vào giỏ hàng</span>
                            <span id="btn-add-spinner" class="hidden material-symbols-outlined animate-spin text-[18px]">progress_activity</span>
                        </button>
                        <button type="submit" asp-action="BuyNow" class="w-full h-12 border text-on-surface font-semibold text-xs uppercase tracking-widest rounded-md hover:bg-on-surface hover:text-white transition-all duration-300 flex items-center justify-center cursor-pointer bg-white" style="border-color: #1a1c1b;">
                            Mua ngay tác phẩm
                        </button>
                    </div>
                }
            </form>

            <div class="flex justify-between items-center pt-2 border-t border-outline-variant/20 text-xs font-bold tracking-wider">
                <a asp-action="Collection" class="text-on-surface hover:text-primary transition-all no-underline flex items-center gap-1"><span class="material-symbols-outlined text-sm">arrow_back</span> Quay lại cửa hàng</a>
            </div>

            <div class="grid grid-cols-2 gap-4 pt-4 border-t border-outline-variant/30">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-primary">verified</span>
                    <span class="text-[13px] font-medium uppercase tracking-tight text-on-surface-variant">Chứng nhận đá quý</span>
                </div>
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-primary">package_2</span>
                    <span class="text-[13px] font-medium uppercase tracking-tight text-on-surface-variant">Hộp quà cao cấp</span>
                </div>
            </div>
        </div>
    </section>

    <section class="bg-surface-container-low/50 py-20 border-t border-outline-variant/30">
        <div class="max-w-4xl mx-auto flex flex-col gap-1">
            <details class="group py-6 border-b border-outline-variant/30" open>
                <summary class="flex justify-between items-center cursor-pointer list-none outline-none font-label-md text-label-md uppercase tracking-widest text-on-surface select-none">
                    <span>Chất liệu & Bảo quản</span>
                    <span class="material-symbols-outlined transition-transform duration-300 group-open:rotate-180">expand_more</span>
                </summary>
                <div class="pt-6 font-body-md text-on-surface-variant flex flex-col gap-4 text-justify leading-relaxed text-sm">
                    <p>Sản phẩm này được chế tác từ vàng nguyên khối 18K hoặc bạc cao cấp với bề mặt được đánh bóng gương hoàn hảo. Mỗi chi tiết đều được các nghệ nhân của AliceStore tinh chỉnh thủ công để đảm bảo sự thoải mái tối đa khi đeo hàng ngày.</p>
                    <ul class="list-disc list-inside space-y-2 p-0 m-0">
                        <li>Lau chùi bằng vải mềm khô sau khi sử dụng.</li>
                        <li>Tránh tiếp xúc trực tiếp với hóa chất và nước hoa.</li>
                        <li>Cất giữ trong hộp riêng khi không sử dụng.</li>
                    </ul>
                </div>
            </details>

            <details class="group py-6 border-b border-outline-variant/30">
                <summary class="flex justify-between items-center cursor-pointer list-none outline-none font-label-md text-label-md uppercase tracking-widest text-on-surface select-none">
                    <span>Giao hàng & Trả hàng</span>
                    <span class="material-symbols-outlined transition-transform duration-300 group-open:rotate-180">expand_more</span>
                </summary>
                <div class="pt-6 text-on-surface-variant leading-relaxed text-justify text-sm">
                    <p>Chúng tôi cung cấp dịch vụ giao hàng cao cấp miễn phí cho tất cả các đơn hàng trang sức trên 5,000 000₫. Đơn hàng sẽ được bảo hiểm toàn phần trong quá trình vận chuyển. Bạn có thể đổi trả sản phẩm trong vòng 14 ngày nếu chưa qua sử dụng và còn nguyên tem mác.</p>
                </div>
            </details>

            <details class="group py-6 border-b border-outline-variant/30">
                <summary class="flex justify-between items-center cursor-pointer list-none outline-none font-label-md text-label-md uppercase tracking-widest text-on-surface select-none">
                    <span>Chính sách Bảo hành</span>
                    <span class="material-symbols-outlined transition-transform duration-300 group-open:rotate-180">expand_more</span>
                </summary>
                <div class="pt-6 text-on-surface-variant leading-relaxed text-justify text-sm">
                    <p>AliceStore cam kết bảo hành trọn đời cho việc làm mới sản phẩm và kiểm tra chấu đá. Bảo hành 2 năm cho bất kỳ lỗi kỹ thuật nào từ nhà sản xuất. Mỗi sản phẩm đi kèm một mã số định danh duy nhất để truy xuất nguồn gốc.</p>
                </div>
            </details>
        </div>
    </section>
</main>

@section Scripts {
    <script>
        // 1. Logic điều hướng tăng giảm số lượng mua hàng thực tế
        function modifyProductQty(delta) {
            const qtyLabel = document.getElementById('display-quantity');
            const qtyActual = document.getElementById('quantity-actual');
            if (!qtyLabel || !qtyActual) return;

            let currentVal = parseInt(qtyLabel.innerText) || 1;
            currentVal += delta;
            if (currentVal < 1) currentVal = 1;

            qtyLabel.innerText = currentVal;
            qtyActual.value = currentVal; // Đồng bộ giá trị vào thẻ input ẩn để submit form
        }

        // 2. 🔥 LOGIC MỚI: Tự động cập nhật lại giá tiền trên màn hình theo Size được bấm chọn
        document.addEventListener('DOMContentLoaded', () => {
            const sizeRadios = document.querySelectorAll('#size-selector-container input[type="radio"]');
            const priceDisplay = document.getElementById('product-price-display');

            // Đọc và hiển thị mức giá của biến thể đầu tiên khi vừa nạp trang xong
            const defaultChecked = document.querySelector('#size-selector-container input[type="radio"]:checked');
            if (defaultChecked && priceDisplay) {
                priceDisplay.innerText = defaultChecked.getAttribute('data-formatted-price');
            }

            // Đăng ký sự kiện thay đổi radio kích cỡ
            sizeRadios.forEach(radio => {
                radio.addEventListener('change', function() {
                    if (this.checked && priceDisplay) {
                        // Cập nhật giá tiền tương ứng của kích cỡ đó lên giao diện (No-reload)
                        priceDisplay.innerText = this.getAttribute('data-formatted-price');
                    }
                });
            });
        });

        // 3. Logic hoán đổi xem ảnh trong bộ sưu tập (Gallery Thumbnails)
        function switchDetailImage(targetPath, element) {
            const focusedImg = document.getElementById('focused-main-img');
            if (focusedImg) {
                focusedImg.src = targetPath;
            }

            const thumbs = document.querySelectorAll('.thumb-div');
            thumbs.forEach(t => {
                t.classList.remove('border-primary', 'opacity-100');
                t.classList.add('border-transparent', 'opacity-60');
            });

            element.classList.add('border-primary', 'opacity-100');
            element.classList.remove('border-transparent', 'opacity-60');
        }
        // 4. AJAX Thêm vào giỏ hàng
        async function submitAddToCartAjax() {
            const form = document.getElementById('add-to-cart-form');
            if (!form) return;

            const btn = document.getElementById('btn-add-cart');
            const btnText = document.getElementById('btn-add-text');
            const btnSpinner = document.getElementById('btn-add-spinner');

            // Show spinner
            btn.disabled = true;
            btnText.classList.add('hidden');
            btnSpinner.classList.remove('hidden');

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: formData
                });

                if (response.ok) {
                    const data = await response.json();
                    if (data.success) {
                        // Update cart count
                        const badge = document.getElementById('cart-count-badge');
                        if (badge) {
                            badge.innerText = data.cartCount;
                            badge.classList.add('scale-150');
                            setTimeout(() => badge.classList.remove('scale-150'), 300);
                        }
                        showToast(data.message, 'success');
                    } else {
                        showToast(data.message, 'error');
                    }
                } else if (response.status === 401 || response.status === 404 && response.url.includes('Login')) {
                    // Chuyển hướng sang trang đăng nhập
                    window.location.href = '/Identity/Account/Login?ReturnUrl=' + encodeURIComponent(window.location.pathname);
                } else {
                    showToast('Đã có lỗi xảy ra. Vui lòng thử lại sau.', 'error');
                }
            } catch (error) {
                console.error(error);
                showToast('Không thể kết nối đến máy chủ.', 'error');
            } finally {
                // Hide spinner
                btn.disabled = false;
                btnText.classList.remove('hidden');
                btnSpinner.classList.add('hidden');
            }
        }

        // 5. Custom Toast Notification
        function showToast(message, type = 'success') {
            let container = document.getElementById('toast-container');
            if (!container) {
                container = document.createElement('div');
                container.id = 'toast-container';
                container.className = 'fixed top-24 right-6 z-[9999] flex flex-col gap-3 pointer-events-none';
                document.body.appendChild(container);
            }

            const toast = document.createElement('div');
            const bgColor = type === 'success' ? 'bg-[#faf9f7] border-[#775a19]' : 'bg-[#fff5f5] border-red-500';
            const iconColor = type === 'success' ? 'text-[#775a19]' : 'text-red-600';
            const iconName = type === 'success' ? 'check_circle' : 'error';
            
            toast.className = `flex items-center gap-3 ${bgColor} border-l-4 shadow-[0_4px_20px_rgba(0,0,0,0.08)] px-5 py-4 rounded pointer-events-auto transform transition-all duration-500 translate-x-full opacity-0`;
            toast.innerHTML = `
                <span class="material-symbols-outlined ${iconColor}">${iconName}</span>
                <span class="font-sans text-sm font-semibold text-on-surface">${message}</span>
            `;

            container.appendChild(toast);

            // Animate in
            requestAnimationFrame(() => {
                toast.classList.remove('translate-x-full', 'opacity-0');
            });

            // Remove after 3s
            setTimeout(() => {
                toast.classList.add('translate-x-full', 'opacity-0');
                setTimeout(() => {
                    if (toast.parentNode) toast.parentNode.removeChild(toast);
                }, 500);
            }, 3000);
        }
    </script>
}