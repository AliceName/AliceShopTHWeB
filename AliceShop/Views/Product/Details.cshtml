@model AliceShop.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";

    // 1. XỬ LÝ LỌC DANH SÁCH ẢNH: Gom tất cả ảnh trong mảng ImageUrls
    var images = Model.ImageUrls?.Where(url => !string.IsNullOrWhiteSpace(url)).ToList() ?? new List<string>();

    // Nếu mảng ImageUrls trống nhưng thuộc tính ImageUrl cũ có ảnh, thì nạp vào danh sách
    if (!images.Any() && !string.IsNullOrEmpty(Model.ImageUrl))
    {
        images.Add(Model.ImageUrl);
    }

    // Nếu hoàn toàn không có ảnh nào, dùng ảnh placeholder mặc định
    if (!images.Any())
    {
        images.Add("/images/placeholder.png");
    }

    // Tự động sửa lỗi thiếu dấu gạch chéo đầu chuỗi cho toàn bộ mảng ảnh nội bộ
    for (int i = 0; i < images.Count; i++)
    {
        if (!images[i].StartsWith("/") && !images[i].StartsWith("http://") && !images[i].StartsWith("https://"))
        {
            images[i] = "/" + images[i];
        }
    }

    // 2. CHUẨN HÓA DANH MỤC
    var categories = ViewBag.CategoriesList as IEnumerable<AliceShop.Models.Category> ?? new List<AliceShop.Models.Category>();
    var categoryName = categories.FirstOrDefault(c => c.Id == Model.CategoryId)?.Name ?? $"Mã số: {Model.CategoryId}";

    // Định nghĩa ID định danh duy nhất cho bộ Carousel để tránh xung đột mã lệnh JS
    var carouselId = $"productGallery-{Model.Id}";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Index" class="text-secondary text-decoration-none small hover-text-warning">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách quản lý
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white">
        <div class="card-header bg-dark text-light py-3 px-4 border-bottom border-warning border-opacity-25">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold tracking-widest text-warning text-uppercase">
                    <i class="bi bi-gem me-2"></i>Thông tin chi tiết sản phẩm
                </h5>
                <span class="badge bg-secondary">Mã định danh: #@Model.Id</span>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">

                <div class="col-md-5 col-lg-4">
                    <div class="rounded-3 bg-light border p-2 d-flex align-items-center justify-content-center overflow-hidden ratio ratio-1x1 mx-auto shadow-sm position-relative main-img-frame" style="max-width: 350px;">
                        <div id="@carouselId" class="carousel slide w-100 h-100" data-bs-ride="false">
                            <div class="carousel-inner w-100 h-100">
                                @for (int i = 0; i < images.Count; i++)
                                {
                                    <div class="carousel-item w-100 h-100 @(i == 0 ? "active" : "")">
                                        <img src="@images[i]" class="w-100 h-100 object-fit-contain rounded" alt="@Model.Name" />
                                    </div>
                                }
                            </div>

                            @if (images.Count > 1)
                            {
                                <button class="carousel-control-prev" type="button" data-bs-target="#@carouselId" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon bg-dark bg-opacity-25 rounded-circle p-2" aria-hidden="true"></span>
                                    <span class="visually-hidden">Trước</span>
                                </button>
                                <button class="carousel-control-next" type="button" data-bs-target="#@carouselId" data-bs-slide="next">
                                    <span class="carousel-control-next-icon bg-dark bg-opacity-25 rounded-circle p-2" aria-hidden="true"></span>
                                    <span class="visually-hidden">Tiếp</span>
                                </button>
                            }
                        </div>
                    </div>

                    @if (images.Count > 1)
                    {
                        <div class="d-flex gap-2 justify-content-center flex-wrap mt-3">
                            @for (int i = 0; i < images.Count; i++)
                            {
                                <button type="button"
                                        class="thumb-btn border rounded p-1 bg-white @(i == 0 ? "active-thumb" : "")"
                                        data-slide-to="@i"
                                        style="width: 60px; height: 60px; transition: all 0.2s ease-in-out;">
                                    <img src="@images[i]" class="w-100 h-100 object-fit-cover rounded" alt="thumb-@i" />
                                </button>
                            }
                        </div>
                    }
                </div>

                <div class="col-md-7 col-lg-8">
                    <div class="table-responsive border rounded-3 bg-light bg-opacity-25">
                        <table class="table table-borderless align-middle mb-0">
                            <tbody>
                                <tr class="border-bottom border-light">
                                    <td class="fw-bold text-secondary ps-3 py-3" style="width: 200px;">
                                        <i class="bi bi-bookmark-fill text-warning me-2"></i>@Html.DisplayNameFor(model => model.Name)
                                    </td>
                                    <td class="text-dark fw-bold fs-5 text-uppercase">
                                        @Html.DisplayFor(model => model.Name)
                                    </td>
                                </tr>
                                <tr class="border-bottom border-light">
                                    <td class="fw-bold text-secondary ps-3 py-3">
                                        <i class="bi bi-tags-fill text-warning me-2"></i>Phân loại danh mục
                                    </td>
                                    <td>
                                        <span class="badge bg-dark text-warning px-3 py-2 rounded-pill fs-7 fw-semibold border border-warning border-opacity-25 shadow-sm">
                                            <i class="bi bi-tag-fill me-1 small"></i> @categoryName
                                        </span>
                                    </td>
                                </tr>
                                <tr class="border-bottom border-light">
                                    <td class="fw-bold text-secondary ps-3 py-3">
                                        <i class="bi bi-cash-coin text-warning me-2"></i>@Html.DisplayNameFor(model => model.Price)
                                    </td>
                                    <td class="text-danger fw-bold fs-4">
                                        @string.Format("{0:N0} đ", Model.Price)
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-secondary ps-3 py-3 align-top pt-3">
                                        <i class="bi bi-file-earmark-text-fill text-warning me-2"></i>@Html.DisplayNameFor(model => model.Description)
                                    </td>
                                    <td class="text-secondary lh-lg small" style="text-align: justify; padding-right: 15px;">
                                        @Html.DisplayFor(model => model.Description)
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-4 d-flex gap-2 justify-content-end">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-arrow-left"></i> Quay lại
                        </a>
                        <a asp-action="Cart" asp-route-id="@Model.Id" class="btn btn-warning px-4 text-dark fw-bold shadow-sm">
                            <i class="bi bi-bag-plus-fill me-1"></i> Thêm vào giỏ hàng
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .tracking-widest {
        letter-spacing: 1px;
    }

    .object-fit-cover {
        object-fit: cover;
    }

    .object-fit-contain {
        object-fit: contain;
    }

    .hover-text-warning:hover {
        color: #ffc107 !important;
    }

    /* Định nghĩa hiệu ứng viền Vàng Kim khi click vào ảnh thu nhỏ tương ứng */
    .thumb-btn {
        opacity: 0.6;
        cursor: pointer;
    }

        .thumb-btn:hover, .active-thumb {
            opacity: 1 !important;
            border-color: #ffc107 !important;
            box-shadow: 0 0 0 1px rgba(255, 193, 7, 0.3);
        }

    /* Tinh chỉnh khung Carousel ẩn hiện mượt mà */
    .carousel-item {
        display: none;
        transition: transform .4s ease-in-out, opacity .4s ease-in-out;
    }

        .carousel-item.active {
            display: block !important;
        }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var carouselEl = document.getElementById('@carouselId');
            if (!carouselEl) return;

            // Khởi tạo thực thể Bootstrap Carousel tĩnh (không tự động chạy slide)
            var bsCarousel = bootstrap.Carousel.getOrCreateInstance(carouselEl, {
                interval: false,
                wrap: true
            });

            // Lấy toàn bộ danh sách các nút bấm ảnh nhỏ thu nhỏ
            var thumbButtons = document.querySelectorAll('.thumb-btn');

            // Viết hàm cập nhật đường viền màu vàng cho ảnh thu nhỏ đang kích hoạt
            function updateActiveThumb(index) {
                thumbButtons.forEach(function (btn) {
                    var slideIndex = parseInt(btn.getAttribute('data-slide-to'), 10);
                    if (slideIndex === index) {
                        btn.classList.add('active-thumb');
                    } else {
                        btn.classList.remove('active-thumb');
                    }
                });
            }

            // Sự kiện 1: Bấm vào ảnh nhỏ -> Chuyển ảnh lớn tương ứng
            thumbButtons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var slideToIndex = parseInt(btn.getAttribute('data-slide-to'), 10);
                    bsCarousel.to(slideToIndex);
                    updateActiveThumb(slideToIndex);
                });
            });

            // Sự kiện 2: Khi bấm mũi tên Lùi/Tiến trên ảnh lớn -> Tự động đồng bộ viền vàng ở ảnh nhỏ phía dưới
            carouselEl.addEventListener('slid.bs.carousel', function (e) {
                updateActiveThumb(e.to);
            });
        });
    </script>
}