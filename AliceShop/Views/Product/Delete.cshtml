@model AliceShop.Models.Product

@{
    ViewData["Title"] = "Xác nhận xóa sản phẩm";
    var mainImgUrl = string.IsNullOrEmpty(Model?.ImageUrl) ? "/images/placeholder.png" : Model.ImageUrl;
}

<main class="pt-12 pb-20 max-w-[1440px] mx-auto px-6 md:px-20 animate-fadeIn">
    <header class="mb-12 border-b border-error/20 pb-6">
        <span class="text-xs font-bold text-error uppercase tracking-widest block mb-1">Cảnh báo hành động hệ thống</span>
        <h1 class="font-serif text-3xl md:text-4xl text-on-surface mb-2 font-medium tracking-wide">Xác nhận gỡ bỏ tác phẩm?</h1>
        <p class="text-secondary font-sans text-sm">Hành động này không thể hoàn tác. Toàn bộ hình ảnh và dữ liệu liên quan trong SQL Server sẽ bị xóa sạch.</p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">

        <div class="lg:col-span-4 bg-surface-container-low p-6 rounded-lg border border-outline-variant/20 shadow-sm">
            <label class="font-semibold text-xs uppercase tracking-widest mb-4 block text-on-surface-variant">Hình ảnh tác phẩm</label>
            <div class="aspect-[4/5] w-full rounded-md overflow-hidden bg-white border border-outline-variant/20 shadow-sm">
                <img src="@mainImgUrl" alt="@Model?.Name" class="w-full h-full object-cover" />
            </div>
            <div class="mt-4 bg-error/5 border border-error/10 p-3 rounded text-center">
                <span class="text-xs font-mono font-bold text-error">MÃ TÁC PHẨM: #@Model?.Id</span>
            </div>
        </div>

        <div class="lg:col-span-8 space-y-8">
            <div class="bg-surface-container-low p-8 rounded-lg border border-outline-variant/20 shadow-sm space-y-6">

                <div>
                    <span class="font-semibold text-xs uppercase tracking-widest text-on-surface-variant block mb-1">Tên tác phẩm</span>
                    <h2 class="font-serif text-2xl font-medium text-on-surface uppercase tracking-wide m-0">@Model?.Name</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-outline-variant/20">
                    <div>
                        <span class="font-semibold text-xs uppercase tracking-widest text-on-surface-variant block mb-1">Danh mục nhóm</span>
                        <span class="inline-block bg-surface-container-high px-3 py-1.5 rounded text-sm font-bold text-secondary border border-outline-variant/20">
                            ✨ @(Model?.Category?.Name ?? "Trang sức")
                        </span>
                    </div>
                    <div>
                        <span class="font-semibold text-xs uppercase tracking-widest text-on-surface-variant block mb-1">Chất liệu chế tác</span>
                        <span class="inline-block bg-surface-container-high px-3 py-1.5 rounded text-sm font-bold text-secondary border border-outline-variant/20">
                            💎 @(Model?.Material?.Name ?? "Cao cấp")
                        </span>
                    </div>
                </div>

                <div class="pt-4 border-t border-outline-variant/20">
                    <span class="font-semibold text-xs uppercase tracking-widest text-on-surface-variant block mb-1">Giá trị niêm yết</span>
                    <p class="font-sans text-xl font-bold text-primary m-0">@string.Format("{0:N0} ₫", Model?.Price)</p>
                </div>

                <div class="pt-4 border-t border-outline-variant/20">
                    <span class="font-semibold text-xs uppercase tracking-widest text-on-surface-variant block mb-1">Thông số / Mô tả câu chuyện</span>
                    <p class="text-on-surface-variant text-sm leading-relaxed text-justify m-0 font-medium">@Model?.Description</p>
                </div>
            </div>

            <form asp-action="Delete" class="pt-4 flex flex-col sm:flex-row gap-4 items-center">
                <input type="hidden" asp-for="Id" />

                <button type="submit" class="w-full sm:w-auto px-12 py-4 text-white font-semibold text-xs uppercase tracking-widest rounded-md transition-all duration-300 flex items-center justify-center gap-2 shadow-sm cursor-pointer" style="background-color: #ba1a1a;">
                    <span class="material-symbols-outlined text-sm">delete_forever</span> Xác Nhận Xóa Vĩnh Viễn
                </button>

                <a asp-action="Index" class="w-full sm:w-auto px-12 py-4 border border-outline text-on-surface font-semibold text-xs uppercase tracking-widest rounded-md hover:bg-surface-container text-center no-underline transition-colors">
                    Hủy Bỏ & Quay Lại
                </a>
            </form>
        </div>
    </div>
</main>