@model AliceShop.Models.Product

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Index" class="text-secondary text-decoration-none small hover-text-warning">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách quản lý
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white mx-auto" style="max-width: 800px;">
        <div class="card-header bg-dark text-light py-3 px-4 border-bottom border-warning border-opacity-25">
            <h5 class="mb-0 fw-bold tracking-widest text-warning text-uppercase">
                <i class="bi bi-pencil-square me-2"></i>Chỉnh sửa thông tin trang sức
            </h5>
        </div>

        <div class="card-body p-4 p-md-5">
            <form asp-action="Edit" enctype="multipart/form-data" autocomplete="off">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small" id="valSummary"></div>

                <input type="hidden" asp-for="Id" />

                <div class="row g-4">
                    <div class="col-12">
                        <div class="form-group">
                            <label asp-for="Name" id="label-name" class="form-label fw-bold text-secondary small text-uppercase">Tên sản phẩm trang sức <span class="text-danger">*</span></label>
                            <input asp-for="Name" id="Name" class="form-control form-control-lg border-2" required />
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="CategoryId" id="label-category" class="form-label fw-bold text-secondary small text-uppercase">Phân loại danh mục <span class="text-danger">*</span></label>
                            <select asp-for="CategoryId" id="CategoryId" asp-items="ViewBag.Categories" class="form-select border-2" required>
                                <option value="">-- Chọn nhóm trang sức --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Price" id="label-price" class="form-label fw-bold text-secondary small text-uppercase">Giá bán niêm yết (VND) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="Price" id="Price" type="number" class="form-control border-2" required />
                                <span class="input-group-text border-2 bg-secondary bg-opacity-10 fw-bold text-secondary">đ</span>
                            </div>
                            <span asp-validation-for="Price" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="mainImageInput" id="label-mainimage" class="form-label fw-bold text-secondary small text-uppercase">Ảnh đại diện chính (Tải lên để thay đổi)</label>
                            <input type="file" name="imageUrl" class="form-control border-2" accept="image/*" id="mainImageInput" />
                        </div>

                        <div class="mt-3 p-2 border rounded bg-light text-center">
                            <div class="text-muted small mb-1 text-uppercase">Ảnh đại diện hiện tại:</div>
                            <img id="mainImagePreview" src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/placeholder.png" : Model.ImageUrl)"
                                 class="rounded border p-1 shadow-sm bg-white" style="height: 100px; max-width: 100%; object-fit: contain;" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="galleryInputs" id="label-gallery" class="form-label fw-bold text-secondary small text-uppercase">Album ảnh chi tiết (Tải lên sẽ thay thế album cũ)</label>
                            <input type="file" name="imageUrls" class="form-control border-2" accept="image/*" multiple id="galleryInputs" />
                        </div>

                        <div class="mt-3 p-2 border rounded bg-light">
                            <div class="text-muted small mb-1 text-uppercase ps-1">Album ảnh chi tiết hiện tại:</div>
                            <div class="d-flex gap-2 flex-wrap" id="galleryPreviewRow" style="min-height: 100px; align-content: flex-start;">
                                @if (Model.ImageUrls != null && Model.ImageUrls.Any())
                                {
                                    foreach (var url in Model.ImageUrls)
                                    {
                                        <img src="@url" class="rounded border p-1 shadow-sm bg-white current-gallery-img" style="height: 45px; width: 45px; object-fit: cover;" />
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small ps-1 pt-2 italic">Chưa có album ảnh phụ</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-group">
                            <label asp-for="Description" id="label-desc" class="form-label fw-bold text-secondary small text-uppercase">Mô tả thông số chi tiết sản phẩm</label>
                            <textarea asp-for="Description" id="Description" class="form-control border-2" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>

                <div class="mt-5 pt-3 border-top d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                        Hủy bỏ
                    </a>
                    <button type="submit" class="btn btn-warning px-4 py-2 text-dark fw-bold shadow-sm">
                        <i class="bi bi-save-fill me-1"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .tracking-widest {
        letter-spacing: 1px;
    }

    .form-control:focus, .form-select:focus {
        border-color: #ffc107 !important;
        box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.15) !important;
    }

    .hover-text-warning:hover {
        color: #ffc107 !important;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Tự động quét khối lỗi
        document.addEventListener("DOMContentLoaded", function () {
            var summary = document.getElementById("valSummary");
            if (summary) {
                // Nếu có chữ báo lỗi bên trong, bật d-none ra để Admin thấy rõ lỗi gì
                if (summary.innerText.trim() !== "") {
                    summary.classList.remove("d-none");
                } else {
                    summary.classList.add("d-none");
                }
            }
        });

        // Preview ảnh đại diện chính
        document.getElementById('mainImageInput').addEventListener('change', function (event) {
            var input = event.target;
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('mainImagePreview').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        });

        // Preview album ảnh phụ
        document.getElementById('galleryInputs').addEventListener('change', function (event) {
            var input = event.target;
            var previewRow = document.getElementById('galleryPreviewRow');
            previewRow.innerHTML = '';

            if (input.files && input.files.length > 0) {
                Array.from(input.files).forEach(function (file) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        var img = document.createElement('img');
                        img.src = e.target.result;
                        img.className = "rounded border p-1 shadow-sm bg-white";
                        img.style = "height: 45px; width: 45px; object-fit: cover;";
                        previewRow.appendChild(img);
                    }
                    reader.readAsDataURL(file);
                });
            } else {
                previewRow.innerHTML = '<span class="text-muted small ps-1 pt-2 italic">Chưa có album ảnh phụ</span>';
            }
        });
    </script>
}