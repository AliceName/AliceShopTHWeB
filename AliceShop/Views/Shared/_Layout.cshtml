<!DOCTYPE html>
<html class="light" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} | " : "")AliceStore</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <script id="tailwind-config">
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#775a19",
                        "on-primary": "#ffffff",
                        "background": "#faf9f7",
                        "on-background": "#1a1c1b",
                        "surface": "#ffffff",
                        "surface-container-low": "#f4f3f1",
                        "surface-container-lowest": "#ffffff",
                        "on-surface-variant": "#4e4639",
                        "outline-variant": "#d1c5b4"
                    },
                    fontFamily: {
                        "sans": ["Inter", "sans-serif"],
                        "serif": ["Lora", "serif"]
                    }
                }
            }
        }
    </script>

    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            display: inline-block;
            line-height: 1;
        }

        .nav-underline-hover::after {
            content: '';
            position: absolute;
            width: 0;
            height: 1px;
            bottom: -2px;
            left: 50%;
            background-color: currentColor;
            transition: all 0.3s ease;
            transform: translateX(-50%);
        }

        input::placeholder {
            color: #7f7667 !important;
            opacity: 0.6 !important;
        }

        .nav-underline-hover:hover::after {
            width: 100%;
        }

        .animate-fadeIn {
            animation: fIn 0.2s ease-in-out forwards;
        }
        @@keyframes fIn {
            from

        {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-background text-on-background font-sans flex flex-col min-h-screen">

    <header id="main-header" class="bg-white/90 backdrop-blur-md sticky top-0 z-50 flex justify-between items-center w-full px-6 md:px-20 py-6 transition-all duration-300 border-b border-outline-variant/30">
        <div class="flex items-center gap-12">
            <a class="font-serif text-2xl uppercase tracking-[0.2em] text-primary no-underline" asp-area="" asp-controller="Home" asp-action="Index">AliceStore</a>

            <nav class="hidden md:flex gap-8">
                <a class="font-semibold text-sm no-underline pb-1 transition-colors @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "text-primary border-b border-primary" : "text-on-surface-variant hover:text-primary relative nav-underline-hover")"
                   asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>

                <a class="font-semibold text-sm no-underline pb-1 transition-colors @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" && ViewContext.RouteData.Values["action"]?.ToString() == "Collection" ? "text-primary border-b border-primary" : "text-on-surface-variant hover:text-primary relative nav-underline-hover")"
                   asp-area="" asp-controller="Product" asp-action="Collection">Bộ sưu tập</a>

                <a class="font-semibold text-sm no-underline pb-1 transition-colors @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Contact" ? "text-primary border-b border-primary" : "text-on-surface-variant hover:text-primary relative nav-underline-hover")"
                   asp-area="" asp-controller="Home" asp-action="Contact">Liên hệ</a>

                @if (User.IsInRole("Admin"))
                {
                    <a class="font-bold text-sm no-underline pb-1 text-primary relative nav-underline-hover flex items-center gap-1 animate-pulse"
                       asp-area="Admin" asp-controller="Product" asp-action="Index">
                        <span class="material-symbols-outlined text-sm">admin_panel_settings</span> Cổng Admin
                    </a>
                }
            </nav>
        </div>

        <div class="flex items-center gap-2 sm:gap-4 z-50">
            <form class="hidden lg:flex items-center bg-surface-container-low border border-outline-variant/60 rounded-full py-1.5 px-4 gap-2 transition-all duration-300 focus-within:border-primary focus-within:bg-white"
                  asp-area="" asp-controller="Product" asp-action="Collection" method="get">
                <button type="submit" class="text-on-surface hover:text-primary transition-colors bg-transparent border-none p-0 flex items-center outline-none cursor-pointer">
                    <i class="bi bi-search text-base"></i>
                </button>
                <input class="bg-transparent border-none text-sm focus:ring-0 p-0 text-on-background placeholder:text-on-surface-variant/70 w-32 focus:w-40 transition-all duration-300 font-semibold tracking-wide"
                       type="search" name="q" placeholder="Tìm trang sức..." value="@Context.Request.Query["q"]" />
            </form>

            @using AliceShop.Extensions
            @{
                var currentCart = Context.Session.GetObjectFromJson<ShoppingCart>("Cart");
                int totalCartCount = currentCart?.TotalQuantity ?? 0;
            }

            <a asp-area="" asp-controller="ShoppingCart" asp-action="Index"
               class="text-on-surface-variant hover:text-primary transition-colors flex items-center justify-center h-10 w-10 relative bg-transparent border-none p-0 outline-none rounded-full hover:bg-surface-container-low/50 no-underline"
               title="Xem giỏ hàng của bạn">
                <i class="bi bi-bag text-lg flex items-center justify-center"></i>
                <span id="cart-count-badge" class="absolute top-1 right-1 bg-primary text-white text-[9px] font-bold h-4 w-4 rounded-full flex items-center justify-center border border-white transition-all duration-300">
                    @totalCartCount
                </span>
            </a>

            @using Microsoft.AspNetCore.Identity
            @inject SignInManager<ApplicationUser> SignInManager
            @inject UserManager<ApplicationUser> UserManager

            <div class="relative group flex items-center h-full">
                @if (SignInManager.IsSignedIn(User))
                {
                    <button class="text-primary hover:text-primary transition-colors flex items-center h-10 w-10 justify-center cursor-pointer bg-transparent border-none p-0 outline-none rounded-full hover:bg-surface-container-low/50" type="button">
                        <i class="bi bi-person-circle text-xl flex items-center justify-center"></i>
                    </button>

                    <div class="absolute top-[100%] right-0 mt-1 w-56 bg-white border border-outline-variant shadow-lg rounded-md py-2 hidden group-hover:block animate-fadeIn z-50
                                    before:content-[''] before:absolute before:-top-3 before:left-0 before:w-full before:h-4 before:bg-transparent">
                        <div class="px-4 py-2 border-b border-b-outline-variant/30">
                            <p class="text-[10px] font-bold uppercase tracking-widest text-primary m-0">Xin chào</p>
                            <p class="text-xs font-semibold text-on-background truncate m-0 mt-0.5">@UserManager.GetUserName(User)</p>
                        </div>
                        <a class="block px-4 py-2 text-sm text-on-surface-variant hover:bg-surface-container-low hover:text-primary no-underline font-medium" asp-area="Identity" asp-page="/Account/Manage/Index">Hồ sơ cá nhân</a>
                        <a class="block px-4 py-2 text-sm text-on-surface-variant hover:bg-surface-container-low hover:text-primary no-underline font-medium" asp-area="" asp-controller="Profile" asp-action="Index">Sổ địa chỉ</a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a class="block px-4 py-2 text-sm text-primary bg-primary/5 hover:bg-primary/10 no-underline font-bold" asp-area="Admin" asp-controller="Product" asp-action="Index">Bảng điều khiển Admin</a>
                        }

                        <hr class="border-outline-variant/40 my-1" />
                        <form class="form-inline block m-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                            <button type="submit" class="w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50 no-underline font-semibold bg-transparent border-none cursor-pointer outline-none">Đăng xuất</button>
                        </form>
                    </div>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login" class="text-on-surface-variant hover:text-primary transition-colors flex items-center h-10 w-10 justify-center rounded-full hover:bg-surface-container-low/50" title="Đăng nhập hệ thống">
                        <i class="bi bi-person text-xl flex items-center justify-center"></i>
                    </a>
                }
            </div>
        </div>
    </header>

    <main class="flex-grow">
        @RenderBody()
    </main>

    <footer class="bg-surface-container-low border-t border-outline-variant mt-auto">
        <div class="w-full px-6 md:px-20 py-16 grid grid-cols-1 md:grid-cols-4 gap-8 max-w-[1440px] mx-auto">
            <div class="flex flex-col gap-4">
                <div class="font-serif text-xl text-primary uppercase tracking-wider">AliceStore</div>
                <p class="text-on-surface-variant text-sm leading-relaxed font-medium">Trang sức thủ công cao cấp với thiết kế tối giản, bền vững và hiện đại.</p>
                <div class="flex gap-4 text-xl mt-2">
                    <a href="#" class="text-on-surface-variant hover:text-primary transition-colors"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="text-on-surface-variant hover:text-primary transition-colors"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="text-on-surface-variant hover:text-primary transition-colors"><i class="bi bi-tiktok"></i></a>
                </div>
            </div>
            <div>
                <h5 class="text-xs font-bold text-on-surface uppercase mb-6 tracking-widest">Khám phá</h5>
                <ul class="flex flex-col gap-3 list-none p-0 m-0">
                    <li><a class="text-sm text-on-surface-variant hover:text-primary no-underline transition-colors font-medium" asp-area="" asp-controller="Product" asp-action="Collection">BST Mới nhất</a></li>
                    <li><a class="text-sm text-on-surface-variant hover:text-primary no-underline transition-colors font-medium" href="#">Nhẫn cưới độc quyền</a></li>
                </ul>
            </div>
            <div>
                <h5 class="text-xs font-bold text-on-surface uppercase mb-6 tracking-widest">Hỗ trợ</h5>
                <ul class="flex flex-col gap-3 list-none p-0 m-0">
                    <li><a class="text-sm text-on-surface-variant hover:text-primary no-underline transition-colors font-medium" asp-area="" asp-controller="Home" asp-action="Contact">Liên hệ hỗ trợ</a></li>
                </ul>
            </div>
            <div>
                <h5 class="text-xs font-bold text-on-surface uppercase mb-6 tracking-widest">Pháp lý</h5>
                <ul class="flex flex-col gap-3 list-none p-0 m-0">
                    <li><a class="text-sm text-on-surface-variant hover:text-primary no-underline transition-colors font-medium" href="#">Chính sách bảo mật</a></li>
                </ul>
            </div>
        </div>

        <div class="w-full px-6 md:px-20 py-8 border-t border-outline-variant/30 flex flex-col md:flex-row justify-between items-center max-w-[1440px] mx-auto gap-4 text-xs text-on-surface-variant/80 font-medium">
            <p class="uppercase tracking-wider">© 2026 ALICESTORE. THIẾT KẾ BỞI TRẦN THỊ NGÀ.</p>
            <div class="flex gap-6 uppercase tracking-wider font-bold">
                <span>TP. Hồ Chí Minh</span>
                <span>HUTECH Software Engineering</span>
            </div>
        </div>
    </footer>

    <div class="md:hidden fixed bottom-0 left-0 w-full bg-white border-t border-outline-variant z-50 flex justify-around items-center py-3 shadow-lg">
        <a class="flex flex-col items-center gap-0.5 text-on-surface-variant no-underline hover:text-primary transition-colors" asp-area="" asp-controller="Home" asp-action="Index">
            <span class="material-symbols-outlined">home</span>
            <span class="text-[10px] font-semibold">Home</span>
        </a>
        <a class="flex flex-col items-center gap-0.5 text-on-surface-variant no-underline hover:text-primary transition-colors" asp-area="" asp-controller="Product" asp-action="Collection">
            <span class="material-symbols-outlined">grid_view</span>
            <span class="text-[10px] font-semibold">Shop</span>
        </a>
        <a class="flex flex-col items-center gap-0.5 text-primary no-underline" asp-area="Admin" asp-controller="Product" asp-action="Index">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1">admin_panel_settings</span>
            <span class="text-[10px] font-bold">Admin</span>
        </a>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        window.addEventListener('scroll', () => {
            const header = document.getElementById('main-header');
            if (window.scrollY > 50) {
                header.classList.add('py-4', 'shadow-md', 'bg-white/95');
                header.classList.remove('py-6', 'bg-white/90');
            } else {
                header.classList.add('py-6', 'bg-white/90');
                header.classList.remove('py-4', 'shadow-md', 'bg-white/95');
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>