<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} | " : "")AliceShop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AliceShop.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top border-bottom border-warning border-opacity-25 shadow-sm">
            <div class="container-fluid px-md-4">
                <a class="navbar-brand text-warning fw-bold tracking-widest fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-gem me-2"></i>ALICE SHOP
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                               asp-area="" asp-controller="Home" asp-action="Index">Trang Chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" && ViewContext.RouteData.Values["action"]?.ToString() == "Collection" ? "active" : "")"
                               asp-area="" asp-controller="Product" asp-action="Collection">Bộ Sưu Tập</a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-warning-emphasis @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" || (ViewContext.RouteData.Values["controller"]?.ToString() == "Product" && ViewContext.RouteData.Values["action"]?.ToString() != "Collection") ? "active text-warning" : "")"
                               href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-sliders me-1"></i> Quản trị Shop
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark shadow border border-secondary" aria-labelledby="adminDropdown">
                                <li>
                                    <a class="dropdown-item py-2" asp-area="" asp-controller="Product" asp-action="Index">
                                        <i class="bi bi-box-seam me-2"></i> Quản lý sản phẩm
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-area="" asp-controller="Product" asp-action="Create">
                                        <i class="bi bi-plus-circle me-2"></i> Thêm sản phẩm mới
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider border-secondary" /></li>
                                <li>
                                    <a class="dropdown-item py-2" asp-area="" asp-controller="Category" asp-action="Index">
                                        <i class="bi bi-tags me-2"></i> Quản lý danh mục
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-area="" asp-controller="Category" asp-action="Create">
                                        <i class="bi bi-folder-plus me-2"></i> Thêm danh mục mới
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Contact" ? "active" : "")"
                               asp-area="" asp-controller="Home" asp-action="Contact">Liên Hệ</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center mt-3 mt-lg-0 gap-3">
                        <form class="d-flex" asp-area="" asp-controller="Product" asp-action="Collection" method="get">
                            <div class="input-group input-group-sm">
                                <input class="form-control bg-secondary bg-opacity-25 border-secondary text-white" type="search" name="q"
                                       placeholder="Tìm trang sức..." value="@Context.Request.Query["q"]" style="min-width: 180px;" />
                                <button class="btn btn-outline-warning border-secondary border-start-0" type="submit">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </form>

                        <a class="position-relative p-2 text-light text-opacity-75 hover-text-warning transition-all"
                           asp-area="" asp-controller="ShoppingCart" asp-action="Index" title="Giỏ hàng">
                            <i class="bi bi-bag-heart fs-4"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem; padding: 0.25em 0.45em;">
                                0
                            </span>
                        </a>
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 py-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="bg-dark text-light mt-auto pt-5 pb-3 border-top border-warning border-opacity-10">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-5 mb-3">
                    <h5 class="text-warning fw-bold tracking-widest mb-3"><i class="bi bi-gem me-2"></i>ALICE SHOP</h5>
                    <p class="text-secondary small lh-lg" style="max-width: 400px;">
                        Hệ thống phân phối và quản trị trang sức, phụ kiện chế tác tinh xảo.
                        Đồng hành cùng vẻ đẹp tự tin, tỏa sáng quý phái của phụ nữ Việt.
                    </p>
                    <div class="d-flex gap-3 fs-5 mt-3">
                        <a href="#" class="text-secondary hover-text-warning transition-all"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-secondary hover-text-warning transition-all"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-secondary hover-text-warning transition-all"><i class="bi bi-tiktok"></i></a>
                    </div>
                </div>
                <div class="col-6 col-md-3 mb-3 ps-md-4">
                    <h6 class="text-uppercase text-warning font-monospace small mb-3">Đường dẫn nhanh</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="Index" class="text-secondary text-decoration-none hover-link">Trang chủ</a></li>
                        <li class="mb-2"><a asp-area="" asp-controller="Product" asp-action="Collection" class="text-secondary text-decoration-none hover-link">Bộ sưu tập</a></li>
                        <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="Contact" class="text-secondary text-decoration-none hover-link">Liên hệ hỗ trợ</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-4 mb-3">
                    <h6 class="text-uppercase text-warning font-monospace small mb-3">Thông tin liên hệ</h6>
                    <ul class="list-unstyled small text-secondary">
                        <li class="mb-2"><i class="bi bi-geo-alt text-warning me-2"></i> 123 Đường ABC, Quận 1, TP. HCM</li>
                        <li class="mb-2"><i class="bi bi-telephone text-warning me-2"></i> Hotline: 1900 1234</li>
                        <li class="mb-2"><i class="bi bi-envelope text-warning me-2"></i> hotro@aliceshop.com</li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary opacity-25 my-4" />
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                <p class="small text-secondary mb-0">&copy; 2026 ALICE SHOP. Thiết kế bởi Trần Thị Ngà.</p>
                <div class="small text-secondary">
                    <span class="me-3">MST: 0123456789</span>
                    <span>HUTECH Software Engineering</span>
                </div>
            </div>
        </div>
    </footer>

    <style>
        .tracking-widest {
            letter-spacing: 2px;
        }

        .hover-text-warning:hover {
            color: #ffc107 !important;
        }

        .hover-link {
            color: #6c757d;
            transition: color 0.2s ease-in-out;
        }

            .hover-link:hover {
                color: #ffc107 !important;
            }

        .transition-all {
            transition: all 0.2s ease-in-out;
        }

        .input-group .form-control::placeholder {
            color: rgba(255,255,255,0.4);
        }

        .input-group .form-control:focus {
            background-color: rgba(255,255,255,0.15) !important;
            border-color: #ffc107;
            box-shadow: none;
        }
    </style>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>