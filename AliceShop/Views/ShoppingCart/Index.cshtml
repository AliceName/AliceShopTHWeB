@model AliceShop.Models.ShoppingCart

@{
    ViewData["Title"] = "Giỏ Hàng Của Bạn | AliceShop";
}

<main class="max-w-[1440px] mx-auto px-6 md:px-20 py-12 animate-fadeIn font-sans">
    <div class="mb-12">
        <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-1">Quy trình mua sắm</span>
        <h1 class="font-serif text-3xl md:text-4xl text-on-background font-medium tracking-wide m-0">Túi Hàng Của Bạn</h1>
    </div>

    @if (Model == null || Model.IsEmpty)
    {
        <div class="py-24 text-center border border-dashed rounded-xl border-outline-variant/50 bg-white/50">
            <span class="material-symbols-outlined text-5xl block mb-4 text-outline-variant animate-pulse">shopping_bag</span>
            <p class="text-sm font-medium text-on-surface-variant m-0 mb-6">Hiện tại chưa có tác phẩm trang sức nào trong túi hàng của bạn.</p>
            <a asp-controller="Product" asp-action="Collection"
               class="inline-flex items-center justify-center px-8 h-12 bg-on-background text-white font-semibold text-xs uppercase tracking-widest rounded-md hover:bg-primary transition-colors no-underline shadow-sm">
                Quay lại cửa hàng
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">

            <div class="lg:col-span-8 space-y-6">
                <div class="overflow-x-auto border border-outline-variant/30 rounded-xl bg-white shadow-[0_4px_20px_rgba(0,0,0,0.01)]">
                    <table class="w-full border-collapse text-left m-0">
                        <thead>
                            <tr class="bg-surface-container-low border-b border-outline-variant/30 text-xs font-bold uppercase tracking-widest text-on-surface-variant">
                                <th class="p-5 font-semibold">Tuyệt tác trang sức</th>
                                <th class="p-5 font-semibold text-center">Số lượng</th>
                                <th class="p-5 font-semibold text-right">Giá bán</th>
                                <th class="p-5 font-semibold text-right">Thành tiền</th>
                                <th class="p-5 font-semibold text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant/20">
                            @foreach (var item in Model.Items)
                            {
                                var productImg = string.IsNullOrEmpty(item.ProductSizeVariant?.Product?.ImageUrl)
                                ? "/images/placeholder.png"
                                : item.ProductSizeVariant.Product.ImageUrl;

                                <tr class="hover:bg-surface-container-low/30 transition-colors align-middle text-sm text-on-surface">

                                    <td class="p-5">
                                        <div class="flex items-center gap-4">
                                            <div class="w-16 aspect-[4/5] bg-surface-container-low rounded overflow-hidden border border-outline-variant/20 flex-shrink-0">
                                                <img src="@productImg" class="w-full h-full object-cover" onerror="this.onerror=null; this.src='/images/placeholder.png';" />
                                            </div>
                                            <div class="space-y-1">
                                                <h4 class="font-serif font-medium text-sm md:text-base text-on-background uppercase tracking-wide m-0 line-clamp-1">
                                                    @item.ProductSizeVariant?.Product?.Name
                                                </h4>
                                                <span class="inline-flex px-2 py-0.5 bg-primary/5 border border-primary/10 rounded text-[11px] font-bold text-primary uppercase tracking-tight">
                                                    Kích cỡ: @item.ProductSizeVariant?.ProductSize?.SizeName
                                                </span>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="p-5">
                                        <form asp-controller="ShoppingCart" asp-action="UpdateQuantity" method="post" class="flex items-center justify-center m-0">
                                            <input type="hidden" name="sizeVariantId" value="@item.ProductSizeVariantId" />
                                            <div class="flex items-center border border-outline-variant rounded bg-white overflow-hidden shadow-inner">
                                                <button type="submit" name="quantity" value="@(item.Quantity - 1)"
                                                        class="px-2.5 py-1 hover:bg-surface-container transition-colors border-none bg-transparent cursor-pointer font-bold text-xs"
                                                        @(item.Quantity <= 1 ? "disabled style='opacity:0.3; cursor:not-allowed;'" : "")>
                                                    <span class="material-symbols-outlined text-base">remove</span>
                                                </button>
                                                <span class="px-3 py-1 text-xs font-bold min-w-[20px] text-center select-none">@item.Quantity</span>
                                                <button type="submit" name="quantity" value="@(item.Quantity + 1)"
                                                        class="px-2.5 py-1 hover:bg-surface-container transition-colors border-none bg-transparent cursor-pointer font-bold text-xs">
                                                    <span class="material-symbols-outlined text-base">add</span>
                                                </button>
                                            </div>
                                        </form>
                                    </td>

                                    <td class="p-5 text-right font-semibold text-on-surface-variant">
                                        @string.Format("{0:N0} ₫", item.ProductSizeVariant?.Price)
                                    </td>

                                    <td class="p-5 text-right font-bold text-primary">
                                        @string.Format("{0:N0} ₫", (item.ProductSizeVariant?.Price * item.Quantity))
                                    </td>

                                    <td class="p-5 text-center">
                                        <a asp-controller="ShoppingCart" asp-action="RemoveFromCart" asp-route-sizeVariantId="@item.ProductSizeVariantId"
                                           class="inline-flex p-2 text-on-surface-variant hover:text-red-600 hover:bg-red-50 rounded-full transition-all no-underline"
                                           title="Loại bỏ món hàng" onclick="return confirm('Xác nhận gỡ tác phẩm này khỏi túi hàng của bạn?')">
                                            <span class="material-symbols-outlined text-lg">delete</span>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="pt-2">
                    <a asp-controller="Product" asp-action="Collection" class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-on-surface hover:text-primary transition-colors no-underline">
                        <span class="material-symbols-outlined text-sm">arrow_back</span> Tiếp tục ngắm sản phẩm
                    </a>
                </div>
            </div>

            <div class="lg:col-span-4 bg-surface-container-low p-6 rounded-xl border border-outline-variant/30 space-y-6 shadow-sm">
                <h3 class="font-sans text-xs font-bold uppercase tracking-widest text-on-background m-0 border-b border-outline-variant/20 pb-4">
                    Tóm tắt đơn hàng
                </h3>

                <div class="space-y-4 text-sm font-medium">
                    <div class="flex justify-between items-center text-on-surface-variant">
                        <span>Số lượng sản phẩm:</span>
                        <span class="font-bold text-on-background">@Model.TotalQuantity món</span>
                    </div>
                    <div class="flex justify-between items-center text-on-surface-variant">
                        <span>Phí vận chuyển (Premium):</span>
                        <span class="text-emerald-700 font-bold uppercase tracking-wide text-xs">Miễn phí</span>
                    </div>

                    <div class="border-t border-outline-variant/20 my-2 pt-4 flex justify-between items-baseline">
                        <span class="font-serif text-base text-on-background uppercase tracking-wider font-semibold">Tổng hóa đơn:</span>
                        <span class="font-sans text-xl font-bold text-primary">@string.Format("{0:N0} ₫", Model.TotalAmount)</span>
                    </div>
                </div>

                <div class="pt-2">
                    <a asp-controller="ShoppingCart" asp-action="Checkout"
                       class="w-full h-12 bg-on-background text-white font-semibold text-xs uppercase tracking-widest rounded-md hover:bg-primary transition-colors duration-300 flex items-center justify-center no-underline shadow-md">
                        Tiến hành đặt hàng
                    </a>
                </div>
            </div>

        </div>
    }
</main>