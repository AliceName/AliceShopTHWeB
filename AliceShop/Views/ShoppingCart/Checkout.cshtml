@model AliceShop.Models.Order

@{
    ViewData["Title"] = "Thông Tin Thanh Toán | AliceShop";
    var cart = ViewBag.Cart as AliceShop.Models.ShoppingCart;
}

<main class="max-w-[1440px] mx-auto px-6 md:px-20 py-12 animate-fadeIn font-sans">
    <div class="mb-12 border-b border-outline-variant/20 pb-6">
        <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-1">Xác nhận thanh toán</span>
        <h1 class="font-serif text-3xl md:text-4xl text-on-background font-medium tracking-wide m-0">Thông Tin Giao Hàng</h1>
    </div>

    <form asp-action="Checkout" method="post" class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start" autocomplete="off">
        @Html.AntiForgeryToken()

        <!-- CỘT TRÁI: THÔNG TIN GIAO HÀNG & PHƯƠNG THỨC THANH TOÁN -->
        <div class="lg:col-span-7 space-y-8">

            <!-- BLOCK 1: ĐỊA CHỈ NHẬN HÀNG -->
            <div class="bg-white p-6 md:p-8 rounded-xl border border-outline-variant/30 shadow-[0_4px_25px_rgba(0,0,0,0.01)] space-y-6">
                <h3 class="text-xs font-bold uppercase tracking-widest text-primary m-0 border-b border-outline-variant/20 pb-3 flex justify-between items-center">
                    <span>Địa chỉ nhận trang sức cao cấp</span>
                    <a asp-controller="Profile" asp-action="Index" target="_blank" class="text-[10px] text-primary underline normal-case tracking-normal hover:text-on-surface transition-colors font-medium">Quản lý sổ địa chỉ</a>
                </h3>

                @if (ViewBag.Addresses != null && ((IEnumerable<AliceShop.Models.UserAddress>)ViewBag.Addresses).Any())
                {
                    <div class="mb-4 space-y-2 bg-surface-container-low p-4 rounded-lg border border-outline-variant/30">
                        <label class="font-bold text-xs uppercase tracking-widest text-on-surface-variant block">Chọn từ Sổ địa chỉ của bạn</label>
                        <select id="addressSelector" class="w-full bg-transparent border-b border-outline-variant py-2 text-sm font-medium text-on-background focus:outline-none focus:border-primary cursor-pointer truncate" onchange="fillAddress(this)">
                            <option value="">+ Nhập địa chỉ mới hoàn toàn</option>
                            @foreach (var addr in (IEnumerable<AliceShop.Models.UserAddress>)ViewBag.Addresses)
                            {
                                if (addr.IsDefault)
                                {
                                    <option value="@addr.Id" data-fullname="@addr.FullName" data-phone="@addr.PhoneNumber" data-address="@addr.DetailedAddress" selected>
                                        [Mặc định] @addr.FullName - @addr.PhoneNumber - @addr.DetailedAddress
                                    </option>
                                }
                                else
                                {
                                    <option value="@addr.Id" data-fullname="@addr.FullName" data-phone="@addr.PhoneNumber" data-address="@addr.DetailedAddress">
                                        @addr.FullName - @addr.PhoneNumber - @addr.DetailedAddress
                                    </option>
                                }
                            }
                        </select>
                    </div>
                }

                <div asp-validation-summary="ModelOnly" class="text-xs text-red-600 bg-red-50 p-3 rounded border border-red-200 font-medium"></div>

                <div>
                    <label asp-for="FullName" class="font-bold text-xs uppercase tracking-widest text-on-surface-variant block mb-2">Họ và tên người nhận <span class="text-red-600">*</span></label>
                    <input asp-for="FullName" class="w-full input-underline py-2.5 px-0 text-sm font-medium text-on-background bg-transparent focus:outline-none focus:ring-0" placeholder="Nhập đầy đủ họ tên người nhận" required />
                    <span asp-validation-for="FullName" class="text-red-600 text-xs font-semibold mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="PhoneNumber" class="font-bold text-xs uppercase tracking-widest text-on-surface-variant block mb-2">Số điện thoại liên hệ <span class="text-red-600">*</span></label>
                    <input asp-for="PhoneNumber" type="tel" class="w-full input-underline py-2.5 px-0 text-sm font-medium text-on-background bg-transparent focus:outline-none focus:ring-0" placeholder="Ví dụ: 0912345678" required />
                    <span asp-validation-for="PhoneNumber" class="text-red-600 text-xs font-semibold mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="ShippingAddress" class="font-bold text-xs uppercase tracking-widest text-on-surface-variant block mb-2">Địa chỉ giao hàng chi tiết <span class="text-red-600">*</span></label>
                    <input asp-for="ShippingAddress" class="w-full input-underline py-2.5 px-0 text-sm font-medium text-on-background bg-transparent focus:outline-none focus:ring-0" placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành" required />
                    <span asp-validation-for="ShippingAddress" class="text-red-600 text-xs font-semibold mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="OrderNote" class="font-bold text-xs uppercase tracking-widest text-on-surface-variant block mb-2">Ghi chú lời nhắn đơn hàng (Tùy chọn)</label>
                    <textarea asp-for="OrderNote" class="w-full input-underline py-2 px-0 text-sm font-medium text-on-background bg-transparent focus:outline-none focus:ring-0 resize-none" rows="3" placeholder="Lời nhắn gửi nghệ nhân hoặc lưu ý thời gian giao hàng nhận..."></textarea>
                    <span asp-validation-for="OrderNote" class="text-red-600 text-xs font-semibold mt-1 block"></span>
                </div>
            </div>

            <!-- 🔥 BLOCK 2: TÍCH HỢP PHƯƠNG THỨC THANH TOÁN ĐA DẠNG -->
            <div class="bg-white p-6 md:p-8 rounded-xl border border-outline-variant/30 shadow-[0_4px_25px_rgba(0,0,0,0.01)] space-y-6">
                <h3 class="text-xs font-bold uppercase tracking-widest text-primary m-0 border-b border-outline-variant/20 pb-3">
                    Phương thức thanh toán bảo mật
                </h3>
                <label class="flex items-start gap-4 p-4 border border-outline rounded-xl cursor-pointer hover:border-primary transition-all bg-white select-none relative group">
                    <input type="radio" name="PaymentMethod" value="COD" class="sr-only peer" onchange="togglePaymentGuide(this)" />
                    <div class="w-4 h-4 rounded-full border border-outline-variant flex items-center justify-center mt-1 flex-shrink-0 peer-checked:border-primary peer-checked:bg-primary after:content-[''] after:w-1.5 after:h-1.4 after:rounded-full after:bg-white transition-all"></div>
                    <div class="flex-grow space-y-1">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-xl text-on-surface-variant group-hover:text-primary transition-colors">local_shipping</span>
                            <h4 class="text-sm font-bold text-on-background m-0">Thanh toán tiền mặt khi bàn giao (COD)</h4>
                        </div>
                        <p class="text-xs text-on-surface-variant font-medium m-0 leading-relaxed">Thanh toán trực tiếp bằng tiền mặt cho nhân viên chuyển phát Premium ngay khi kiểm tra và nhận hộp quà trang sức.</p>
                    </div>
                </label>
                <div class="grid grid-cols-1 gap-4">
                    <!-- 1. Thanh toán Chuyển khoản ngân hàng -->
                    <label class="flex items-start gap-4 p-4 border border-outline rounded-xl cursor-pointer hover:border-primary transition-all bg-white select-none relative group">
                        <input type="radio" name="PaymentMethod" value="BankTransfer" class="sr-only peer" checked onchange="togglePaymentGuide(this)" />
                        <div class="w-4 h-4 rounded-full border border-outline-variant flex items-center justify-center mt-1 flex-shrink-0 peer-checked:border-primary peer-checked:bg-primary after:content-[''] after:w-1.5 after:h-1.4 after:rounded-full after:bg-white transition-all"></div>
                        <div class="flex-grow space-y-1">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-xl text-on-surface-variant group-hover:text-primary transition-colors">account_balance</span>
                                <h4 class="text-sm font-bold text-on-background m-0">Chuyển khoản Ngân hàng (Qua mã QR)</h4>
                            </div>
                            <p class="text-xs text-on-surface-variant font-medium m-0 leading-relaxed">Quét mã VietQR tự động qua ứng dụng Mobile Banking của mọi ngân hàng để xử lý giao dịch lập tức.</p>
                        </div>
                    </label>

                    <!-- 2. Thanh toán Thẻ tín dụng/Thẻ ghi nợ -->
                    <label class="flex items-start gap-4 p-4 border border-outline rounded-xl cursor-pointer hover:border-primary transition-all bg-white select-none relative group">
                        <input type="radio" name="PaymentMethod" value="CreditCard" class="sr-only peer" onchange="togglePaymentGuide(this)" />
                        <div class="w-4 h-4 rounded-full border border-outline-variant flex items-center justify-center mt-1 flex-shrink-0 peer-checked:border-primary peer-checked:bg-primary after:content-[''] after:w-1.5 after:h-1.4 after:rounded-full after:bg-white transition-all"></div>
                        <div class="flex-grow space-y-1">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-xl text-on-surface-variant group-hover:text-primary transition-colors">credit_card</span>
                                <h4 class="text-sm font-bold text-on-background m-0">Thẻ Quốc tế Credit / Debit Card</h4>
                            </div>
                            <p class="text-xs text-on-surface-variant font-medium m-0 leading-relaxed">Hỗ trợ các cổng thẻ phổ biến Visa, Mastercard, JCB bảo mật cao qua tiêu chuẩn PCI-DSS.</p>
                        </div>
                    </label>

                    <!-- 3. Thanh toán qua Ví điện tử -->
                    <label class="flex items-start gap-4 p-4 border border-outline rounded-xl cursor-pointer hover:border-primary transition-all bg-white select-none relative group">
                        <input type="radio" name="PaymentMethod" value="EWallet" class="sr-only peer" onchange="togglePaymentGuide(this)" />
                        <div class="w-4 h-4 rounded-full border border-outline-variant flex items-center justify-center mt-1 flex-shrink-0 peer-checked:border-primary peer-checked:bg-primary after:content-[''] after:w-1.5 after:h-1.4 after:rounded-full after:bg-white transition-all"></div>
                        <div class="flex-grow space-y-1">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-xl text-on-surface-variant group-hover:text-primary transition-colors">account_balance_wallet</span>
                                <h4 class="text-sm font-bold text-on-background m-0">Ví điện tử thông minh (Momo / ZaloPay)</h4>
                            </div>
                            <p class="text-xs text-on-surface-variant font-medium m-0 leading-relaxed">Thanh toán một chạm cực nhanh thông qua kết nối liên kết trực tiếp ứng dụng ví của bạn.</p>
                        </div>
                    </label>
                </div>

                <!-- Khung chỉ dẫn chuyển khoản động -->
                <div id="bank-transfer-guide" class="p-4 bg-surface-container-low rounded-xl border border-dashed border-outline-variant/60 space-y-2 animate-fadeIn text-xs text-on-surface-variant font-medium leading-relaxed">
                    <p class="m-0 text-primary font-bold uppercase tracking-wide flex items-center gap-1"><span class="material-symbols-outlined text-sm">info</span> Hướng dẫn chuyển khoản:</p>
                    <p class="m-0">Sau khi bấm nút **"Xác Nhận Đặt Hàng"**, hệ thống sẽ tạo vận đơn và hiển thị cổng quét mã VietQR mang giá trị số tiền hóa đơn chuẩn xác của bạn. Đơn hàng sẽ được chuyển trạng thái sang đã thanh toán tự động ngay khi tiền nổi về tài khoản hệ thống.</p>
                </div>
            </div>

            <div class="flex items-center justify-between pt-2">
                <a asp-controller="ShoppingCart" asp-action="Index" class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-on-surface hover:text-primary transition-colors no-underline">
                    <span class="material-symbols-outlined text-sm">arrow_back</span> Quay lại giỏ hàng
                </a>
            </div>
        </div>

        <!-- CỘT PHẢI: TÓM TẮT ĐƠN HÀNG & MÓN ĐỒ SỞ HỮU -->
        <div class="lg:col-span-5 bg-surface-container-low p-6 md:p-8 rounded-xl border border-outline-variant/30 space-y-6 shadow-sm">
            <h3 class="text-xs font-bold uppercase tracking-widest text-on-background m-0 border-b border-outline-variant/20 pb-4">
                Tác phẩm sở hữu
            </h3>

            @if (cart != null && cart.Items.Any())
            {
                <div class="max-h-[320px] overflow-y-auto divide-y divide-outline-variant/20 pr-1">
                    @foreach (var item in cart.Items)
                    {
                        <div class="flex items-center gap-4 py-4 first:pt-0 last:pb-0">
                            <div class="w-12 aspect-[4/5] bg-white border border-outline-variant/20 rounded overflow-hidden flex-shrink-0">
                                <img src="@(string.IsNullOrEmpty(item.ProductSizeVariant?.Product?.ImageUrl) ? "/images/placeholder.png" : item.ProductSizeVariant.Product.ImageUrl)" class="w-full h-full object-cover" onerror="this.onerror=null; this.src='/images/placeholder.png';" />
                            </div>
                            <div class="flex-grow min-w-0">
                                <h4 class="font-serif font-medium text-xs md:text-sm uppercase tracking-wide text-on-background m-0 line-clamp-1">@item.ProductSizeVariant?.Product?.Name</h4>
                                <div class="flex items-center gap-2 mt-1">
                                    <span class="text-[10px] font-bold text-primary uppercase">Size: @item.ProductSizeVariant?.ProductSize?.SizeName</span>
                                    <span class="text-[10px] text-on-surface-variant/60">•</span>
                                    <span class="text-[10px] font-medium text-on-surface-variant">SL: @item.Quantity</span>
                                </div>
                            </div>
                            <span class="text-xs font-bold text-on-background flex-shrink-0">@string.Format("{0:N0} ₫", (item.ProductSizeVariant.Price * item.Quantity))</span>
                        </div>
                    }
                </div>
            }

            <div class="border-t border-outline-variant/20 pt-4 space-y-3 text-sm font-medium">
                <div class="flex justify-between items-center text-on-surface-variant">
                    <span>Tổng phí vận chuyển:</span>
                    <span class="text-emerald-700 font-bold uppercase text-xs tracking-wide">Miễn phí (Premium)</span>
                </div>
                <div class="flex justify-between items-baseline border-t border-outline-variant/20 pt-4 mt-2">
                    <span class="font-serif text-sm font-semibold uppercase tracking-wider text-on-background">Thành tiền cuối cùng:</span>
                    <span class="text-xl font-bold text-primary font-sans">@string.Format("{0:N0} ₫", cart?.TotalAmount)</span>
                </div>
            </div>

            <div class="pt-4">
                <button type="submit" class="w-full h-12 bg-on-background text-white font-semibold text-xs uppercase tracking-widest rounded-md hover:bg-primary transition-colors duration-300 shadow-md cursor-pointer outline-none border border-transparent font-sans">
                    Xác Nhận Đặt Hàng
                </button>
            </div>
        </div>
    </form>
</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // 1. Đồng bộ tự động điền địa chỉ cũ từ Sổ địa chỉ của khách hàng
        function fillAddress(select) {
            var option = select.options[select.selectedIndex];
            if (option.value) {
                document.getElementById('FullName').value = option.getAttribute('data-fullname');
                document.getElementById('PhoneNumber').value = option.getAttribute('data-phone');
                document.getElementById('ShippingAddress').value = option.getAttribute('data-address');
            } else {
                document.getElementById('FullName').value = '';
                document.getElementById('PhoneNumber').value = '';
                document.getElementById('ShippingAddress').value = '';
            }
        }

        // 2. 🔥 KHỐI MỚI: Bật/tắt nhãn hướng dẫn chuyển khoản động khi thay đổi radio chọn cổng thanh toán
        function togglePaymentGuide(radio) {
            const guideBox = document.getElementById('bank-transfer-guide');
            if (!guideBox) return;

            if (radio.value === 'BankTransfer') {
                guideBox.classList.remove('hidden');
            } else {
                guideBox.classList.add('hidden');
            }
        }
        function togglePaymentGuide(radio) {
            const guideBox = document.getElementById('bank-transfer-guide');
            if (!guideBox) return;

            // Chỉ hiển thị khung hướng dẫn chuyển khoản nếu người dùng chọn đúng BankTransfer
            if (radio.value === 'BankTransfer') {
                guideBox.classList.remove('hidden');
            } else {
                guideBox.classList.add('hidden');
            }
        }
    </script>
}