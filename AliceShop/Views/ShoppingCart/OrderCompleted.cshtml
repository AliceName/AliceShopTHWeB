@model int
@inject AliceShop.Models.ApplicationDbContext _context

@{
    ViewData["Title"] = "Xác nhận vận đơn | AliceShop";

    // Truy vấn trực tiếp trạng thái đơn hàng thời gian thực từ Database để render giao diện tương ứng
    var order = await _context.Orders.FindAsync(Model);
    var paymentMethodUsed = ViewBag.PaymentMethodUsed as string;
}

<main class="max-w-[1440px] mx-auto px-6 md:px-20 py-16 text-center animate-fadeIn font-sans">
    <div class="max-w-xl mx-auto space-y-6 bg-white p-8 md:p-10 rounded-xl border border-outline-variant/30 shadow-[0_4px_25px_rgba(0,0,0,0.01)]">

        @if (order != null && order.Status == "Paid")
        {
            <div class="inline-flex items-center justify-center w-16 h-16 bg-emerald-50 rounded-full text-emerald-600 mb-2 border border-emerald-100">
                <span class="material-symbols-outlined text-3xl">verified_user</span>
            </div>
            <div class="space-y-2">
                <span class="text-[10px] font-bold text-emerald-700 uppercase tracking-[0.2em] block">Giao dịch an toàn hoàn tất</span>
                <h1 class="font-serif text-2xl md:text-3xl text-on-background font-medium tracking-wide uppercase m-0">Giao dịch thành công</h1>
                <p class="text-xs text-primary font-bold uppercase tracking-widest">Tuyệt tác mã số hóa đơn: #@Model</p>
            </div>
            <div class="bg-emerald-50/40 border border-emerald-200/50 p-5 rounded-lg text-left space-y-2">
                <p class="text-xs text-emerald-950 m-0 leading-relaxed font-semibold">Hệ thống AliceShop đã xác thực khoản thanh toán thành công thông qua cổng kết nối bảo mật @paymentMethodUsed.</p>
            </div>
        }
        else if (order != null && order.PaymentMethod == "COD")
        {
            <div class="inline-flex items-center justify-center w-16 h-16 bg-blue-50 rounded-full text-blue-600 mb-2 border border-blue-100">
                <span class="material-symbols-outlined text-3xl">local_shipping</span>
            </div>

            <div class="space-y-2">
                <span class="text-[10px] font-bold text-blue-700 uppercase tracking-[0.2em] block">Xác nhận vận đơn thu hộ</span>
                <h1 class="font-serif text-2xl md:text-3xl text-on-background font-medium tracking-wide uppercase m-0">Đặt hàng thành công</h1>
                <p class="text-xs text-primary font-bold uppercase tracking-widest">Mã số vận đơn của bạn: #@Model</p>
            </div>

            <div class="bg-blue-50/40 border border-blue-200/40 p-5 rounded-lg text-left space-y-2">
                <h4 class="text-xs font-bold text-blue-800 uppercase tracking-wider m-0 flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">info</span> Lưu ý luồng giao nhận COD:
                </h4>
                <p class="text-xs text-on-surface-variant m-0 leading-relaxed text-justify font-medium">
                    Túi hàng của bạn đã được ghi nhận thành công với hình thức **Thanh toán tiền mặt khi nhận hàng**. Số tiền bạn cần chuẩn bị để gửi cho shipper khi bàn giao bưu kiện là: <span class="text-primary font-bold">@string.Format("{0:N0} ₫", order?.TotalAmount ?? 0)</span>.
                </p>
                <p class="text-[11px] text-on-surface-variant/70 m-0">AliceShop hỗ trợ đồng kiểm trang sức cao cấp trước khi thanh toán tiền mặt.</p>
            </div>
        }
        else
        {
            <span class="material-symbols-outlined text-primary text-6xl animate-pulse">pending_actions</span>
            <div class="space-y-2">
                <h1 class="font-serif text-2xl md:text-3xl text-on-background font-medium tracking-wide uppercase m-0">Vận đơn chờ thanh toán</h1>
                <p class="text-xs text-primary font-bold uppercase tracking-widest">Mã số hóa đơn của bạn: #@Model</p>
            </div>
        }

        <!-- 4. Hệ thống nút điều hướng chung -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-4 border-t border-outline-variant/20">
            <a asp-controller="Home" asp-action="Index"
               class="inline-flex items-center justify-center px-8 h-11 bg-on-background text-white font-semibold text-xs uppercase tracking-widest rounded-md hover:bg-primary transition-all duration-300 no-underline shadow-sm">
                Quay lại trang chủ
            </a>
            <a asp-controller="Profile" asp-action="Orders"
               class="inline-flex items-center justify-center px-8 h-11 border border-outline text-on-background font-semibold text-xs uppercase tracking-widest rounded-md hover:bg-surface-container-low transition-all duration-300 no-underline">
                Theo dõi đơn hàng
            </a>
        </div>

    </div>
</main>