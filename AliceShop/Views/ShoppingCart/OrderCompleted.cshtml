@model int

@{
    ViewData["Title"] = "Đặt Hàng Thành Công | AliceShop";
}

<main class="max-w-[1440px] mx-auto px-6 md:px-20 py-24 text-center animate-fadeIn font-sans">
    <div class="max-w-md mx-auto space-y-6 bg-surface-container-low/50 p-8 rounded-xl border border-outline-variant/30 shadow-sm">
        <span class="material-symbols-outlined text-primary text-6xl animate-bounce">task_alt</span>
        <div class="space-y-2">
            <h1 class="font-serif text-2xl md:text-3xl text-on-background font-medium tracking-wide uppercase m-0">Đặt Hàng Thành Công</h1>
            <p class="text-xs text-primary font-bold uppercase tracking-widest">Mã số hóa đơn của bạn: #@Model</p>
        </div>
        <p class="text-sm text-on-surface-variant leading-relaxed text-justify sm:text-center m-0 font-medium">
            Cảm ơn bạn đã lựa chọn kiệt tác từ AliceStore. Nghệ nhân kim hoàn của chúng tôi sẽ tiến hành kiểm tra, đóng gói hộp quà cao cấp và liên hệ giao hàng tới bạn trong thời gian sớm nhất.
        </p>
        <div class="pt-4">
            <a asp-controller="Home" asp-action="Index"
               class="inline-flex items-center justify-center px-8 h-12 bg-on-background text-white font-semibold text-xs uppercase tracking-widest rounded-md hover:bg-primary transition-colors no-underline shadow-sm w-full">
                Quay lại trang chủ
            </a>
        </div>
    </div>
</main>